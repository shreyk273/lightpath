@@ -0,0 +1,553 @@
+/**
+ * @file src/mac_keymap.h
+ * @brief macOS keyboard semantics for Mac clients streaming a Linux/Windows desktop.
+ *
+ * Mac users press Cmd where PC users press Ctrl, move by word with Option+arrows, jump to the
+ * line start with Cmd+Left, switch windows with Cmd+Tab and search with Cmd+Space. This
+ * translator turns the client's physical keys into the host shortcuts that do the same thing:
+ *
+ * | Mac                      | Host                          |
+ * |--------------------------|-------------------------------|
+ * | Cmd + key                | Ctrl + key                    |
+ * | Cmd + key in a terminal  | Ctrl + Shift + key (copy, paste, new tab, ...) |
+ * | Cmd + click              | Ctrl + click                  |
+ * | Control + Cmd + key      | Super + key (the PC's own Super shortcuts) |
+ * | Cmd tapped alone         | Super (Activities overview)   |
+ * | Cmd + Tab / Cmd + `      | Alt + Tab / Alt + ` (held)    |
+ * | Cmd + Left / Right       | Home / End                    |
+ * | Cmd + Up / Down          | Ctrl + Home / Ctrl + End      |
+ * | Cmd + Backspace          | delete to line start          |
+ * | Cmd + Space              | Super (search)                |
+ * | Cmd + H / Cmd + M        | Super + H (hide window)       |
+ * | Cmd + [ / Cmd + ]        | Alt + Left / Alt + Right      |
+ * | Cmd + Shift + 3          | the PC's full-screen screenshot shortcut |
+ * | Cmd + Shift + 4 / 5      | the PC's screenshot tool      |
+ * | Option + arrows          | Ctrl + arrows (word/paragraph)|
+ * | Option + Backspace / Del | Ctrl + Backspace / Delete     |
+ * | Option + other key       | Alt + key                     |
+ * | Control + key            | Ctrl + key (Ctrl+C still interrupts in a terminal) |
+ *
+ * Shift passes through untouched, so Cmd+Shift+Z is Ctrl+Shift+Z and Shift+Option+Left
+ * selects a word. Host modifiers are always pressed before stale ones are released, so no
+ * application ever sees a lone Alt tap (which would toggle menu bars).
+ *
+ * The translator is pure: it emits host key events into a vector and owns no I/O, which keeps
+ * it trivially testable. What it cannot see (whether a terminal has focus, the PC's screenshot
+ * shortcuts) is handed to it by the caller.
+ */
+#pragma once
+
+// standard includes
+#include <cstdint>
+#include <optional>
+#include <string_view>
+#include <unordered_map>
+#include <vector>
+
+namespace mac_keymap {
+  /**
+   * @brief Windows virtual-key codes used by the GameStream protocol.
+   */
+  namespace vk {
+    constexpr std::uint16_t BACK = 0x08;
+    constexpr std::uint16_t TAB = 0x09;
+    constexpr std::uint16_t SPACE = 0x20;
+    constexpr std::uint16_t END = 0x23;
+    constexpr std::uint16_t HOME = 0x24;
+    constexpr std::uint16_t LEFT = 0x25;
+    constexpr std::uint16_t UP = 0x26;
+    constexpr std::uint16_t RIGHT = 0x27;
+    constexpr std::uint16_t DOWN = 0x28;
+    constexpr std::uint16_t DEL = 0x2E;
+    constexpr std::uint16_t KEY_H = 0x48;
+    constexpr std::uint16_t KEY_M = 0x4D;
+    constexpr std::uint16_t LWIN = 0x5B;
+    constexpr std::uint16_t RWIN = 0x5C;
+    constexpr std::uint16_t SHIFT = 0x10;
+    constexpr std::uint16_t CONTROL = 0x11;
+    constexpr std::uint16_t LSHIFT = 0xA0;
+    constexpr std::uint16_t RSHIFT = 0xA1;
+    constexpr std::uint16_t LCONTROL = 0xA2;
+    constexpr std::uint16_t RCONTROL = 0xA3;
+    constexpr std::uint16_t MENU = 0x12;
+    constexpr std::uint16_t KEY_3 = 0x33;
+    constexpr std::uint16_t KEY_4 = 0x34;
+    constexpr std::uint16_t KEY_5 = 0x35;
+    constexpr std::uint16_t KEY_A = 0x41;
+    constexpr std::uint16_t KEY_D = 0x44;
+    constexpr std::uint16_t KEY_T = 0x54;
+    constexpr std::uint16_t KEY_U = 0x55;
+    constexpr std::uint16_t KEY_W = 0x57;
+    constexpr std::uint16_t KEY_Z = 0x5A;
+    constexpr std::uint16_t LMENU = 0xA4;
+    constexpr std::uint16_t RMENU = 0xA5;
+    constexpr std::uint16_t OEM_3 = 0xC0;  ///< ` ~
+    constexpr std::uint16_t OEM_4 = 0xDB;  ///< [ {
+    constexpr std::uint16_t OEM_6 = 0xDD;  ///< ] }
+  }  // namespace vk
+
+  /**
+   * @brief One key event for the host.
+   */
+  struct host_event_t {
+    std::uint16_t vk;  ///< Virtual-key code.
+    bool release;  ///< Key up.
+
+    bool operator==(const host_event_t &) const = default;
+  };
+
+  using events_t = std::vector<host_event_t>;
+
+  /**
+   * @return True for navigation keys that need the "extended" flag on Windows hosts.
+   */
+  constexpr bool is_extended(std::uint16_t code) {
+    switch (code) {
+      case vk::END:
+      case vk::HOME:
+      case vk::LEFT:
+      case vk::UP:
+      case vk::RIGHT:
+      case vk::DOWN:
+      case vk::DEL:
+      case vk::LWIN:
+      case vk::RWIN:
+      case vk::RCONTROL:
+      case vk::RMENU:
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  /**
+   * @brief A host shortcut: modifiers plus one key (for example Shift+Super+S).
+   */
+  struct chord_t {
+    bool ctrl = false;
+    bool alt = false;
+    bool super = false;
+    bool shift = false;
+    std::uint16_t key = 0;
+
+    bool operator==(const chord_t &) const = default;
+  };
+
+  /**
+   * @brief Parse a GTK accelerator such as "<Shift><Super>s" or "Print".
+   *
+   * Only what desktop shortcuts use is understood: Ctrl/Alt/Super/Shift and a letter, a digit,
+   * Print or F1-F12.
+   *
+   * @return The chord, or nothing for anything else.
+   */
+  constexpr std::optional<chord_t> parse_accel(std::string_view accel) {
+    chord_t c;
+    auto lower = [](char ch) {
+      return ch >= 'A' && ch <= 'Z' ? static_cast<char>(ch - 'A' + 'a') : ch;
+    };
+    auto iequals = [&](std::string_view a, std::string_view b) {
+      if (a.size() != b.size()) {
+        return false;
+      }
+      for (std::size_t k = 0; k < a.size(); ++k) {
+        if (lower(a[k]) != lower(b[k])) {
+          return false;
+        }
+      }
+      return true;
+    };
+    while (!accel.empty() && accel.front() == '<') {
+      const auto end = accel.find('>');
+      if (end == std::string_view::npos) {
+        return std::nullopt;
+      }
+      const auto mod = accel.substr(1, end - 1);
+      if (iequals(mod, "ctrl") || iequals(mod, "control") || iequals(mod, "primary")) {
+        c.ctrl = true;
+      } else if (iequals(mod, "alt")) {
+        c.alt = true;
+      } else if (iequals(mod, "super")) {
+        c.super = true;
+      } else if (iequals(mod, "shift")) {
+        c.shift = true;
+      } else {
+        return std::nullopt;
+      }
+      accel.remove_prefix(end + 1);
+    }
+    if (accel.size() == 1) {
+      const char ch = lower(accel.front());
+      if (ch >= 'a' && ch <= 'z') {
+        c.key = static_cast<std::uint16_t>('A' + (ch - 'a'));
+      } else if (ch >= '0' && ch <= '9') {
+        c.key = static_cast<std::uint16_t>(ch);
+      } else {
+        return std::nullopt;
+      }
+      return c;
+    }
+    if (iequals(accel, "print")) {
+      c.key = 0x2C;
+      return c;
+    }
+    if (accel.size() >= 2 && lower(accel.front()) == 'f') {
+      int n = 0;
+      for (const char ch : accel.substr(1)) {
+        if (ch < '0' || ch > '9') {
+          return std::nullopt;
+        }
+        n = n * 10 + (ch - '0');
+      }
+      if (n >= 1 && n <= 12) {
+        c.key = static_cast<std::uint16_t>(0x70 + n - 1);
+        return c;
+      }
+    }
+    return std::nullopt;
+  }
+
+  /**
+   * @brief Stateful Mac → host shortcut translator for one client.
+   */
+  class translator_t {
+  public:
+    /**
+     * @brief Feed one client key event.
+     *
+     * @param code Client virtual-key code (normalized, without the 0x8000 flag).
+     * @param release Key up.
+     * @param shift_held Whether the client currently holds Shift (already pressed on the host).
+     * @param out Host events to emit, in order.
+     * @return True when the translator handled the key; false means "pass it through as is".
+     */
+    bool key(std::uint16_t code, bool release, bool shift_held, events_t &out) {
+      if (is_shift(code)) {
+        // Shift always travels the normal path, which keeps the caller's Shift state exact.
+        if (!release) {
+          lone_cmd = false;
+        }
+        return false;
+      }
+      if (const auto bit = cmd_bit(code)) {
+        const bool was_held = cmd != 0;
+        update(cmd, bit, release);
+        if (!release && !was_held) {
+          // Possibly the start of a lone tap, which means Super like the Windows key.
+          lone_cmd = !opt && !ctl && held.empty();
+        } else if (!release) {
+          lone_cmd = false;  // second Cmd key
+        }
+        set_mods(base(), out);
+        if (release && !cmd && lone_cmd) {
+          lone_cmd = false;
+          tap(vk::LWIN, out);
+        }
+        return true;
+      }
+      if (const auto bit = opt_bit(code)) {
+        update(opt, bit, release);
+        lone_cmd = false;
+        set_mods(base(), out);
+        return true;
+      }
+      if (const auto bit = ctl_bit(code)) {
+        update(ctl, bit, release);
+        lone_cmd = false;
+        set_mods(base(), out);
+        return true;
+      }
+      if (!release) {
+        lone_cmd = false;
+      }
+
+      if (release) {
+        const auto it = held.find(code);
+        if (it == held.end()) {
+          return false;
+        }
+        out.push_back({it->second, true});
+        held.erase(it);
+        if (host.shift) {
+          // The extra Shift of a terminal shortcut lasts as long as its key.
+          set_mods({host.ctrl, host.alt, host.super, false}, out);
+        }
+        return true;
+      }
+
+      if (!cmd && !opt) {
+        // Plain typing, or Control + key (the host already holds Ctrl for it).
+        return false;
+      }
+
+      if (const auto it = held.find(code); it != held.end()) {
+        // A press without a release in between (lost packet): release the old mapping first.
+        out.push_back({it->second, true});
+        held.erase(it);
+      }
+
+      if (cmd && ctl) {
+        // Control + Cmd: the PC's own Super shortcuts, untouched.
+        return map(code, code, base(), out);
+      }
+
+      if (cmd) {
+        switch (code) {
+          case vk::TAB:
+          case vk::OEM_3:
+            // Alt stays down until Cmd is released, so the window switcher stays open.
+            return map(code, code, {false, true, false}, out);
+          case vk::LEFT:
+            return map(code, vk::HOME, {}, out);
+          case vk::RIGHT:
+            return map(code, vk::END, {}, out);
+          case vk::UP:
+            return map(code, vk::HOME, {true, false, false}, out);
+          case vk::DOWN:
+            return map(code, vk::END, {true, false, false}, out);
+          case vk::OEM_4:
+            return map(code, vk::LEFT, {false, true, false}, out);
+          case vk::OEM_6:
+            return map(code, vk::RIGHT, {false, true, false}, out);
+          case vk::KEY_H:
+          case vk::KEY_M:
+            return map(code, vk::KEY_H, {false, false, true}, out);
+          case vk::SPACE:
+            set_mods({}, out);
+            tap(vk::LWIN, out);
+            return true;
+          case vk::KEY_3:
+          case vk::KEY_4:
+          case vk::KEY_5:
+            if (shift_held) {
+              chord(code == vk::KEY_3 ? shot_full : shot_tool, out);  // Shift is held
+              return true;
+            }
+            break;
+          case vk::BACK:
+            if (terminal) {
+              // Shells: kill to the line start.
+              return map(code, vk::KEY_U, {true, false, false}, out);
+            }
+            // Select to the line start, then delete the selection (or the line break when the
+            // cursor already is at the start, like on a Mac).
+            set_mods({}, out);
+            release_target(vk::BACK, out);
+            if (!shift_held) {
+              out.push_back({vk::LSHIFT, false});
+            }
+            tap(vk::HOME, out);
+            if (!shift_held) {
+              out.push_back({vk::LSHIFT, true});
+            }
+            tap(vk::BACK, out);
+            return true;
+          default:
+            break;
+        }
+        if (terminal && code >= vk::KEY_A && code <= vk::KEY_Z) {
+          // Terminals use Ctrl+Shift for copy, paste, new tab, ...: Ctrl+C must stay "interrupt".
+          return map(code, code, {true, opt != 0, false, !shift_held}, out);
+        }
+        return map(code, code, {true, opt != 0, false}, out);
+      }
+
+      // Option without Cmd
+      switch (code) {
+        case vk::BACK:
+          if (terminal) {
+            return map(code, vk::KEY_W, {true, false, false}, out);  // shells: delete word
+          }
+          return map(code, code, {true, false, false}, out);
+        case vk::DEL:
+          if (terminal) {
+            return map(code, vk::KEY_D, {false, true, false}, out);  // shells: delete next word
+          }
+          return map(code, code, {true, false, false}, out);
+        case vk::LEFT:
+        case vk::RIGHT:
+        case vk::UP:
+        case vk::DOWN:
+          return map(code, code, {true, false, false}, out);
+        default:
+          return map(code, code, {false, true, false}, out);
+      }
+    }
+
+    /**
+     * @brief A mouse button is about to be pressed: Cmd+click must arrive as Ctrl+click.
+     */
+    void pointer_button(events_t &out) {
+      lone_cmd = false;
+      if (cmd || opt || ctl) {
+        set_mods(base(), out);
+      }
+    }
+
+    /**
+     * @brief The client scrolled or zoomed: a Cmd held meanwhile is not a lone tap.
+     */
+    void pointer_used() {
+      lone_cmd = false;
+    }
+
+    /**
+     * @brief Whether the focused window on the host is a terminal.
+     */
+    void set_terminal(bool focused) {
+      terminal = focused;
+    }
+
+    /**
+     * @brief The host's screenshot shortcuts (full screen, and the interactive tool).
+     */
+    void set_screenshot_shortcuts(chord_t full, chord_t tool) {
+      shot_full = full;
+      shot_tool = tool;
+    }
+
+    /**
+     * @brief Release everything the translator holds on the host (stream ends or resets).
+     */
+    void reset(events_t &out) {
+      for (const auto &[client, host_key] : held) {
+        out.push_back({host_key, true});
+      }
+      held.clear();
+      cmd = opt = ctl = 0;
+      lone_cmd = false;
+      set_mods({}, out);
+    }
+
+    /**
+     * @return Whether Cmd is held on the client.
+     */
+    bool cmd_held() const {
+      return cmd != 0;
+    }
+
+  private:
+    struct mods_t {
+      bool ctrl = false;
+      bool alt = false;
+      bool super = false;
+      bool shift = false;  ///< Extra Shift (terminal shortcuts); the client's own is not ours.
+    };
+
+    static bool is_shift(std::uint16_t code) {
+      return code == vk::SHIFT || code == vk::LSHIFT || code == vk::RSHIFT;
+    }
+
+    static std::uint8_t cmd_bit(std::uint16_t code) {
+      return code == vk::LWIN ? 1 : code == vk::RWIN ? 2 : 0;
+    }
+
+    static std::uint8_t opt_bit(std::uint16_t code) {
+      return code == vk::LMENU || code == vk::MENU ? 1 : code == vk::RMENU ? 2 : 0;
+    }
+
+    static std::uint8_t ctl_bit(std::uint16_t code) {
+      return code == vk::LCONTROL || code == vk::CONTROL ? 1 : code == vk::RCONTROL ? 2 : 0;
+    }
+
+    static void update(std::uint8_t &mask, std::uint8_t bit, bool release) {
+      mask = release ? (mask & ~bit) : (mask | bit);
+    }
+
+    mods_t base() const {
+      if (cmd && ctl) {
+        return {false, opt != 0, true};
+      }
+      return {cmd != 0 || ctl != 0, opt != 0, false};
+    }
+
+    /**
+     * @brief Move the host's translator-owned modifiers to @p want, new ones first.
+     */
+    void set_mods(mods_t want, events_t &out) {
+      if (want.ctrl && !host.ctrl) {
+        out.push_back({vk::RCONTROL, false});
+      }
+      if (want.alt && !host.alt) {
+        out.push_back({vk::LMENU, false});
+      }
+      if (want.super && !host.super) {
+        out.push_back({vk::LWIN, false});
+      }
+      if (want.shift && !host.shift) {
+        out.push_back({vk::RSHIFT, false});
+      }
+      if (!want.ctrl && host.ctrl) {
+        out.push_back({vk::RCONTROL, true});
+      }
+      if (!want.alt && host.alt) {
+        out.push_back({vk::LMENU, true});
+      }
+      if (!want.super && host.super) {
+        out.push_back({vk::LWIN, true});
+      }
+      if (!want.shift && host.shift) {
+        out.push_back({vk::RSHIFT, true});
+      }
+      host = want;
+    }
+
+    /**
+     * @brief Two client keys can map to the same host key (Cmd+Left and Cmd+Up both press
+     * Home, Cmd+Backspace taps Home): keep every host key pressed at most once.
+     */
+    void release_target(std::uint16_t target, events_t &out) {
+      for (auto it = held.begin(); it != held.end(); ++it) {
+        if (it->second == target) {
+          out.push_back({target, true});
+          held.erase(it);
+          return;
+        }
+      }
+    }
+
+    bool map(std::uint16_t client, std::uint16_t target, mods_t mods, events_t &out) {
+      release_target(target, out);
+      set_mods(mods, out);
+      out.push_back({target, false});
+      held[client] = target;
+      return true;
+    }
+
+    void tap(std::uint16_t code, events_t &out) {
+      release_target(code, out);
+      out.push_back({code, false});
+      out.push_back({code, true});
+    }
+
+    /**
+     * @brief Press a host shortcut once, while the client holds Shift (Cmd+Shift+3).
+     *
+     * A shortcut without Shift (GNOME's default "Print") lets go of the host's Shift first: the
+     * client's later Shift release then finds it already up, which is harmless, whereas
+     * pressing it again could leave the other Shift key stuck.
+     */
+    void chord(chord_t c, events_t &out) {
+      if (!c.key) {
+        return;
+      }
+      set_mods({c.ctrl, c.alt, c.super, false}, out);
+      if (!c.shift) {
+        out.push_back({vk::LSHIFT, true});
+        out.push_back({vk::RSHIFT, true});
+      }
+      tap(c.key, out);
+      set_mods(base(), out);
+    }
+
+    std::uint8_t cmd = 0;  ///< Client Cmd keys held (bit 0 left, bit 1 right).
+    std::uint8_t opt = 0;  ///< Client Option keys held.
+    std::uint8_t ctl = 0;  ///< Client Control keys held.
+    bool lone_cmd = false;  ///< Cmd is down and nothing else happened yet.
+    bool terminal = false;  ///< A terminal has focus on the host.
+    chord_t shot_full {false, false, false, true, 0x2C};  ///< GNOME default: Shift+Print.
+    chord_t shot_tool {false, false, false, false, 0x2C};  ///< GNOME default: Print.
+    mods_t host;  ///< Modifiers the translator currently holds on the host.
+    std::unordered_map<std::uint16_t, std::uint16_t> held;  ///< Client key → host key it pressed.
+  };
+}  // namespace mac_keymap
