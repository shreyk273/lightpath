+    /**
+     * @brief Whether an address belongs to a VPN overlay (Tailscale: 100.64.0.0/10, fd7a:115c:a1e0::/48).
+     *
+     * @param address Address to classify.
+     * @return True for overlay addresses.
+     */
+    bool is_overlay_address(const boost::asio::ip::address &address) {
+      if (address.is_v6()) {
+        const auto v6 = address.to_v6();
+        if (v6.is_v4_mapped()) {
+          return is_overlay_address(boost::asio::ip::make_address_v4(boost::asio::ip::v4_mapped, v6));
+        }
+        const auto b = v6.to_bytes();
+        return b[0] == 0xfd && b[1] == 0x7a && b[2] == 0x11 && b[3] == 0x5c && b[4] == 0xa1 && b[5] == 0xe0;
+      }
+      return (address.to_v4().to_uint() & 0xFFC00000u) == 0x64400000u;
+    }
+
+    /**
