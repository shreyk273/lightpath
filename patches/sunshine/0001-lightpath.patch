+        std::this_thread::sleep_for(100ms);
+      }
+      return false;
+    }
+
+    /**
+     * @brief Wait until Wayland clients (including Sunshine's input mapping) see the new layout.
+     *
+     * @param expect_exclusive Whether the virtual monitor should be the only output.
+     */
+    void wait_for_layout(bool expect_exclusive) const {
+      const int logical_w = static_cast<int>(std::lround(width / scale));
+      const int logical_h = static_cast<int>(std::lround(height / scale));
+      const auto deadline = std::chrono::steady_clock::now() + LAYOUT_SETTLE_TIMEOUT;
+      while (std::chrono::steady_clock::now() < deadline) {
+        const auto outputs = wl::monitors();
+        const bool found = std::ranges::any_of(outputs, [&](const auto &m) {
+          return m->name == connector && m->viewport.logical_width == logical_w && m->viewport.logical_height == logical_h;
+        });
+        if (found && (!expect_exclusive || outputs.size() == 1)) {
+          return;
+        }
+        std::this_thread::sleep_for(20ms);
+      }
+      BOOST_LOG(warning) << "[muttergrab] Timed out waiting for the Wayland output layout to settle"sv;
+    }
+
+    connection_t conn;  ///< Private D-Bus connection owning the session.
+    std::string session_path;  ///< Mutter ScreenCast session object path.
+    std::string stream_path;  ///< Mutter ScreenCast stream object path.
+    std::string connector;  ///< Virtual monitor connector (empty in probe mode).
+    uint32_t node_id = PW_ID_ANY;  ///< PipeWire node of the stream.
+    int width = 0;  ///< Virtual monitor width.
+    int height = 0;  ///< Virtual monitor height.
+    double scale = 1;  ///< Applied logical monitor scale.
+    uint32_t inhibit_cookie = 0;  ///< Session manager inhibitor cookie.
+    bool detached_physical = false;  ///< Whether make_exclusive() removed physical outputs.
+
+  private:
+    /**
+     * @brief Connect and create a ScreenCast session.
+     *
+     * @return True on success.
+     */
+    bool open_session() {
+      if (!conn.open()) {
+        return false;
+      }
+      g_autoptr(GVariant) version = conn.call(SCREENCAST_BUS, SCREENCAST_PATH, "org.freedesktop.DBus.Properties", "Get", g_variant_new("(ss)", SCREENCAST_IFACE, "Version"), G_VARIANT_TYPE("(v)"));
+      if (!version) {
+        return false;
+      }
+      g_autoptr(GVariant) inner = nullptr;
+      g_variant_get(version, "(v)", &inner);
+      if (const auto api = g_variant_get_int32(inner); api < static_cast<int32_t>(MIN_API_VERSION)) {
+        BOOST_LOG(error) << "[muttergrab] Mutter ScreenCast API version "sv << api << " is too old (need "sv << MIN_API_VERSION << ", GNOME 46 or newer)"sv;
+        return false;
+      }
+      g_autoptr(GVariant) reply = conn.call(SCREENCAST_BUS, SCREENCAST_PATH, SCREENCAST_IFACE, "CreateSession", g_variant_new("(a{sv})", nullptr), G_VARIANT_TYPE("(o)"));
+      if (!reply) {
+        return false;
+      }
+      session_path = get_object_path(reply);
+      return true;
+    }
+
+    /**
+     * @brief Start the session and wait for the PipeWire node announcement.
+     *
+     * @return True once the node id is known.
+     */
+    bool start_and_wait_for_node() {
+      GMainContext *context = g_main_context_new();
+      g_main_context_push_thread_default(context);
+      const guint subscription = g_dbus_connection_signal_subscribe(
+        conn.conn,
+        nullptr,
+        STREAM_IFACE,
+        "PipeWireStreamAdded",
+        stream_path.c_str(),
+        nullptr,
+        G_DBUS_SIGNAL_FLAGS_NONE,
+        [](GDBusConnection *, const gchar *, const gchar *, const gchar *, const gchar *, GVariant *parameters, gpointer user_data) {
+          g_variant_get(parameters, "(u)", static_cast<uint32_t *>(user_data));
+        },
+        &node_id,
+        nullptr
+      );
+
+      g_autoptr(GVariant) started = conn.call(SCREENCAST_BUS, session_path.c_str(), SESSION_IFACE, "Start", nullptr, nullptr);
+      const auto deadline = std::chrono::steady_clock::now() + STREAM_ADDED_TIMEOUT;
+      while (started && node_id == PW_ID_ANY && std::chrono::steady_clock::now() < deadline) {
+        if (!g_main_context_iteration(context, FALSE)) {
+          std::this_thread::sleep_for(2ms);
+        }
+      }
+
+      g_dbus_connection_signal_unsubscribe(conn.conn, subscription);
+      while (g_main_context_iteration(context, FALSE)) {
+      }
+      g_main_context_pop_thread_default(context);
+      g_main_context_unref(context);
+
+      if (node_id == PW_ID_ANY) {
+        BOOST_LOG(error) << "[muttergrab] Mutter did not announce a PipeWire stream"sv;
+        return false;
+      }
+      return true;
+    }
+
+    /**
+     * @brief Keep GNOME from blanking or suspending while a client is watching.
+     *
+     * Also tells other session tools (e.g. auto-sleep daemons that honour inhibitors) that the
+     * machine is in use.
+     */
+    void inhibit_idle() {
+      g_autoptr(GVariant) reply = conn.call(SESSION_MANAGER_BUS, SESSION_MANAGER_PATH, SESSION_MANAGER_IFACE, "Inhibit", g_variant_new("(susu)", "sunshine", 0u, "Streaming to a Moonlight client", INHIBIT_IDLE | INHIBIT_SUSPEND), G_VARIANT_TYPE("(u)"));
+      if (reply) {
+        g_variant_get(reply, "(u)", &inhibit_cookie);
+      }
+    }
+
+    /**
+     * @brief Pick the logical scale for the virtual monitor.
+     *
+     * Defaults to Mutter's own heuristic for the mode (2x for Retina-class resolutions, which is
+     * what macOS uses as well), overridable with SUNSHINE_MUTTER_SCALE.
+     *
+     * @param mode Current mode of the virtual monitor.
+     * @return A scale Mutter accepts for that mode.
+     */
+    static double pick_scale(const mode_info_t &mode) {
+      const double wanted = env_double("SUNSHINE_MUTTER_SCALE").value_or(mode.preferred_scale);
+      if (mode.supported_scales.empty()) {
+        return 1.0;
+      }
+      return *std::ranges::min_element(mode.supported_scales, [wanted](double a, double b) {
+        return std::abs(a - wanted) < std::abs(b - wanted);
+      });
+    }
+
+    /**
+     * @brief Extract the object path from a "(o)" reply.
+     *
+     * @param reply Reply variant.
+     * @return Object path.
+     */
+    static std::string get_object_path(GVariant *reply) {
+      const gchar *path = nullptr;
+      g_variant_get(reply, "(&o)", &path);
+      return path;
+    }
+  };
+
+  /**
+   * @brief Turn off physical outputs that were removed from the layout, once the stream runs.
+   *
+   * Some drivers (NVIDIA) keep scanning out the last frame of a monitor that is no longer part
+   * of the layout, so a projector or TV would show a frozen picture for the whole stream. A
+   * display power-save cycle makes Mutter re-enable only the outputs that are still configured.
+   * It is done a moment after capture started, from a separate thread and D-Bus connection,
+   * so it never delays the first frame; the stream sees at most a sub-second hiccup.
+   *
+   * @param weak Session that detached the outputs; nothing happens if it is already gone.
+   */
+  void blank_detached_outputs_later(std::weak_ptr<screencast_session_t> weak) {
+    std::thread([weak = std::move(weak)]() {
+      std::this_thread::sleep_for(BLANK_DELAY);
+      const auto session = weak.lock();
+      if (!session) {
+        return;
+      }
+      connection_t conn;
+      if (!conn.open()) {
+        return;
+      }
+      const auto start = std::chrono::steady_clock::now();
+      for (const int mode : {3, 0}) {
+        g_autoptr(GVariant) r = conn.call(DISPLAY_CONFIG_BUS, DISPLAY_CONFIG_PATH, "org.freedesktop.DBus.Properties", "Set", g_variant_new("(ssv)", DISPLAY_CONFIG_IFACE, "PowerSaveMode", g_variant_new_int32(mode)), nullptr);
+      }
+      const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+      BOOST_LOG(info) << "[muttergrab] Switched off the physical displays removed from the layout ("sv << ms << " ms)"sv;
+    }).detach();
+  }
+
+  /**
+   * @brief Shares one virtual monitor between consecutive capture objects of a stream.
+   *
+   * Sunshine recreates its display object on capture re-initialisation. Tearing the virtual
+   * monitor down every time would bounce all windows to the physical screen and back, so the
+   * monitor lingers for a few seconds after the last user releases it and is reused when the
+   * next request asks for the same mode.
+   */
+  class virtual_display_pool_t {
+  public:
+    virtual_display_pool_t():
+        reaper([this](std::stop_token stop) {
+          reap(stop);
+        }) {
+    }
+
+    ~virtual_display_pool_t() {
+      reaper.request_stop();
+      cv.notify_all();
+    }
+
+    /**
+     * @brief Get a virtual monitor for the requested mode.
+     *
+     * @param mode Requested mode.
+     * @return Session, or nullptr on failure.
+     */
+    std::shared_ptr<screencast_session_t> acquire(const mode_request_t &mode) {
+      std::unique_lock lock(mutex);
+      if (current && current_mode == mode) {
+        ++users;
+        release_at.reset();
+        BOOST_LOG(info) << "[muttergrab] Reusing virtual display "sv << current->connector;
+        return current;
+      }
+      current.reset();  // Different mode: drop the old monitor first.
+
+      auto session = std::make_shared<screencast_session_t>();
+      if (!session->start_virtual(mode)) {
+        return nullptr;
+      }
+      if (!env_flag("SUNSHINE_MUTTER_KEEP_PHYSICAL")) {
+        if (!session->make_exclusive()) {
+          BOOST_LOG(warning) << "[muttergrab] Could not make the virtual display exclusive; it will extend the desktop instead"sv;
+        }
+        session->wait_for_layout(true);
+        if (session->detached_physical && !env_flag("SUNSHINE_MUTTER_NO_BLANK")) {
+          blank_detached_outputs_later(session);
+        }
+      } else {
+        session->wait_for_layout(false);
+      }
+
+      current = session;
+      current_mode = mode;
+      users = 1;
+      release_at.reset();
+      return current;
+    }
+
+    /**
+     * @brief Release a session previously returned by acquire().
+     */
+    void release() {
+      std::scoped_lock lock(mutex);
+      if (users > 0 && --users == 0) {
+        release_at = std::chrono::steady_clock::now() + LINGER;
+        cv.notify_all();
+      }
+    }
+
+  private:
+    /**
+     * @brief Background thread destroying idle sessions after the linger period.
+     *
+     * @param stop Stop token.
+     */
+    void reap(const std::stop_token &stop) {
+      std::unique_lock lock(mutex);
+      while (!stop.stop_requested()) {
+        if (release_at) {
+          if (cv.wait_until(lock, stop, *release_at, [this] {
+                return !release_at || users > 0;
+              })) {
+            continue;
+          }
+          if (release_at && users == 0 && std::chrono::steady_clock::now() >= *release_at) {
+            release_at.reset();
+            auto doomed = std::move(current);
+            lock.unlock();
+            doomed.reset();
+            lock.lock();
+          }
+        } else {
+          cv.wait(lock, stop, [this] {
+            return release_at.has_value();
+          });
+        }
+      }
+      current.reset();
+    }
+
+    std::mutex mutex;
+    std::condition_variable_any cv;
+    std::shared_ptr<screencast_session_t> current;
+    mode_request_t current_mode {0, 0, 0};
+    int users = 0;
+    std::optional<std::chrono::steady_clock::time_point> release_at;
+    std::jthread reaper;
+  };
+
+  /**
+   * @brief Process-wide virtual display pool.
+   *
+   * @return Pool instance.
+   */
+  virtual_display_pool_t &pool() {
+    static virtual_display_pool_t instance;
+    return instance;
+  }
+
+  /**
+   * @brief PipeWire display backed by a Mutter virtual monitor.
+   */
+  class mutter_t: public pipewire::pipewire_display_t {
+  public:
+    explicit mutter_t(const ::video::config_t &config):
+        request {config.width, config.height, config.framerateX100 > 0 ? config.framerateX100 / 100.0 : static_cast<double>(config.framerate)} {
+    }
+
+    ~mutter_t() override {
+      if (pooled) {
+        pool().release();
+      }
+    }
+
+    mutter_t(const mutter_t &) = delete;
+    mutter_t &operator=(const mutter_t &) = delete;
+
+    /**
+     * @brief Create (or reuse) the virtual monitor and hand its PipeWire node to the base class.
+     *
+     * @param display_name Ignored; the virtual display always matches the client.
+     * @param out_pipewire_fd Set to -1 (local PipeWire daemon).
+     * @param out_pipewire_node PipeWire node id.
+     * @param out_pipewire_object_serial Left invalid; the node id is used.
+     * @return 0 on success.
+     */
+    int configure_stream(const std::string &display_name [[maybe_unused]], int &out_pipewire_fd, uint32_t &out_pipewire_node, uint64_t &out_pipewire_object_serial [[maybe_unused]]) override {
+      if (platf::encoder_probe_active.load()) {
+        if (!configure_probe()) {
+          return -1;
+        }
+      } else {
+        session = pool().acquire(request);
+        if (!session) {
+          return -1;
+        }
+        pooled = true;
+        output_name = session->connector;
+        offset_x = 0;
+        offset_y = 0;
+        width = session->width;
+        height = session->height;
+        logical_width = static_cast<int>(std::lround(width / session->scale));
+        logical_height = static_cast<int>(std::lround(height / session->scale));
+      }
+      out_pipewire_fd = -1;
+      out_pipewire_node = session->node_id;
+      return 0;
+    }
+
+    /**
+     * @brief Negotiate the exact client frame rate for virtual monitors.
+     *
+     * The virtual monitor refreshes at exactly the client's rate, so Mutter delivers frames at that
+     * cadence and Sunshine can encode each one the moment it arrives (event-driven, no extra
+     * pacing delay).
+     *
+     * @return True outside of encoder probing.
+     */
+    bool prefer_fixed_framerate() const override {
+      return !platf::encoder_probe_active.load();
+    }
+
+  private:
+    /**
+     * @brief Record the current primary monitor without changing any layout (encoder probe).
+     *
+     * @return True on success.
+     */
+    bool configure_probe() {
+      session = std::make_shared<screencast_session_t>();
+      std::string target;
+      {
+        connection_t conn;
+        if (!conn.open()) {
+          return false;
+        }
+        const auto state = get_display_state(conn);
+        if (!state) {
+          return false;
+        }
+        target = state->primary_connector;
+      }
+      if (target.empty()) {
+        // Headless: nothing to disturb, a virtual monitor is fine.
+        if (!session->start_virtual(request)) {
+          return false;
+        }
+      } else if (!session->start_monitor(target)) {
+        return false;
+      }
+      width = request.width;
+      height = request.height;
+      logical_width = 0;
+      logical_height = 0;
+      return true;
+    }
+
+    mode_request_t request;
+    std::shared_ptr<screencast_session_t> session;
+    bool pooled = false;
+  };
+
+  /**
+   * @brief Check whether Mutter's ScreenCast API is reachable on the session bus.
+   *
+   * @return True when Mutter can create virtual monitors.
+   */
+  bool available() {
+    connection_t conn;
+    if (!conn.open()) {
+      return false;
+    }
+    g_autoptr(GVariant) version = conn.call(SCREENCAST_BUS, SCREENCAST_PATH, "org.freedesktop.DBus.Properties", "Get", g_variant_new("(ss)", SCREENCAST_IFACE, "Version"), G_VARIANT_TYPE("(v)"));
+    if (!version) {
+      return false;
+    }
+    g_autoptr(GVariant) inner = nullptr;
+    g_variant_get(version, "(v)", &inner);
+    return g_variant_get_int32(inner) >= static_cast<int32_t>(MIN_API_VERSION);
+  }
+}  // namespace mutter
+
+namespace platf {
+  /**
+   * @brief Create a Mutter virtual display capture backend.
+   *
+   * @param hwdevice_type Hardware device type requested for capture or encode.
+   * @param display_name Display name (ignored).
+   * @param config Client stream configuration; its resolution and frame rate define the virtual monitor.
+   * @return Display backend, or nullptr when initialization fails.
+   */
+  std::shared_ptr<display_t> mutter_display(mem_type_e hwdevice_type, const std::string &display_name, const video::config_t &config) {
+    if (!pipewire::pipewire_display_t::init_pipewire_and_check_hwdevice_type(hwdevice_type)) {
+      BOOST_LOG(error) << "[muttergrab] Could not initialize pipewire-based display with the given hw device type."sv;
+      return nullptr;
+    }
+
+    auto display = std::make_shared<mutter::mutter_t>(config);
+    if (display->init(hwdevice_type, display_name, config)) {
+      return nullptr;
+    }
+    return display;
+  }
+
+  /**
+   * @brief Enumerate Mutter virtual display names.
+   *
+   * @return A single name: the virtual display is created per stream to match the client.
+   */
+  std::vector<std::string> mutter_display_names() {
+    if (!mutter::available()) {
+      return {};
+    }
+    // The "Meta-" prefix tells the PipeWire layer that frame timestamps come from a virtual
+    // monitor's own clock and are reliable for pacing.
+    return {"Meta-virtual"};
+  }
+}  // namespace platf
