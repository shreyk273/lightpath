+      g_autoptr(GVariant) reply = conn.call(SCREENCAST_BUS, session_path.c_str(), SESSION_IFACE, "RecordVirtual", g_variant_new("(a{sv})", &props), G_VARIANT_TYPE("(o)"));
+      if (!reply) {
+        return false;
+      }
+      stream_path = get_object_path(reply);
+
+      // The monitor is created when the session starts; then find the connector it got.
+      if (!start_and_wait_for_node()) {
+        return false;
+      }
+      const auto deadline = std::chrono::steady_clock::now() + LAYOUT_SETTLE_TIMEOUT;
+      while (connector.empty() && std::chrono::steady_clock::now() < deadline) {
+        if (const auto after = get_display_state(conn)) {
+          for (const auto &monitor : after->monitors) {
