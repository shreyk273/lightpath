+  /**
+   * @brief Check whether Mutter's ScreenCast API is reachable on the session bus.
+   *
+   * @return True when Mutter can create virtual monitors.
+   */
+  bool available() {
+    connection_t conn;
+    if (!conn.open()) {
+      return false;
+    }
+    g_autoptr(GVariant) version = conn.call(SCREENCAST_BUS, SCREENCAST_PATH, "org.freedesktop.DBus.Properties", "Get", g_variant_new("(ss)", SCREENCAST_IFACE, "Version"), G_VARIANT_TYPE("(v)"));
+    if (!version) {
+      return false;
+    }
+    g_autoptr(GVariant) inner = nullptr;
+    g_variant_get(version, "(v)", &inner);
+    return g_variant_get_int32(inner) >= static_cast<int32_t>(MIN_API_VERSION);
+  }
