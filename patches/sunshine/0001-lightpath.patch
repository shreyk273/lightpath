+/**
+ * @file src/platform/linux/mutter_rd.cpp
+ * @brief GNOME (Mutter) remote desktop session: clipboard sharing and touchpad-style scrolling.
+ *
+ * One org.gnome.Mutter.RemoteDesktop session is kept while streams run (and for a short while
+ * after the last one ends, so a client can still fetch the clipboard while disconnecting). All
+ * D-Bus signal handling happens on a dedicated GLib main loop thread; scroll events and
+ * clipboard requests are issued from the calling threads, which GDBus allows.
+ *
+ * Clipboard model: the PC clipboard is read on demand (SelectionRead). Content the client sends
+ * is offered with SetSelection and served from memory on SelectionTransfer; Mutter's own
+ * clipboard manager keeps a copy, so it survives the end of the session.
+ */
+// standard includes
+#include <algorithm>
+#include <cctype>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <functional>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <string_view>
+#include <thread>
+#include <vector>
+
+// platform includes
+#include <fcntl.h>
+#include <gio/gio.h>
+#include <gio/gunixfdlist.h>
+#include <poll.h>
+#include <unistd.h>
+
+// lib includes
+#include <nlohmann/json.hpp>
+
+// local includes
+#include "mutter_rd.h"
+#include "src/logging.h"
+
+using namespace std::literals;
+
+namespace mutter_rd {
+  namespace {
+    constexpr const char *RD_BUS = "org.gnome.Mutter.RemoteDesktop";
+    constexpr const char *RD_PATH = "/org/gnome/Mutter/RemoteDesktop";
+    constexpr const char *RD_IFACE = "org.gnome.Mutter.RemoteDesktop";
+    constexpr const char *SESSION_IFACE = "org.gnome.Mutter.RemoteDesktop.Session";
+    constexpr guint32 AXIS_FINISH = 1u << 0;  ///< META_REMOTE_DESKTOP_NOTIFY_AXIS_FLAGS_FINISH
+    constexpr guint32 AXIS_SOURCE_FINGER = 1u << 2;  ///< META_REMOTE_DESKTOP_NOTIFY_AXIS_FLAGS_SOURCE_FINGER
+    constexpr int CALL_TIMEOUT_MS = 3000;
+    constexpr gint64 SCROLL_FINISH_AFTER_US = 80'000;  ///< Fingers are considered lifted after this pause.
+    constexpr guint SCROLL_FINISH_POLL_MS = 20;
+    constexpr guint LINGER_S = 15;  ///< Keep the session after the last stream ends.
+    constexpr auto READ_TIMEOUT = 1500ms;
+    constexpr const char *TEXT_MIME = "text/plain;charset=utf-8";
+    constexpr const char *PNG_MIME = "image/png";
+    /// Every name X11 and Wayland applications ask for when pasting text.
+    constexpr const char *TEXT_OFFERS[] = {"text/plain;charset=utf-8", "text/plain", "UTF8_STRING", "STRING", "TEXT"};
+    /// Best text format first when reading from the PC.
+    constexpr const char *TEXT_READ_ORDER[] = {"text/plain;charset=utf-8", "UTF8_STRING", "text/plain", "STRING", "TEXT"};
+
+    constexpr const char *SHELL_BUS = "org.gnome.Shell";
+    /// Lightpath's GNOME Shell helper, then Couch Helper: both announce focus changes.
+    constexpr const char *LIGHTPATH_HELPER_PATH = "/org/lightpath/Helper";
+    constexpr const char *LIGHTPATH_HELPER_IFACE = "org.lightpath.Helper";
+    constexpr const char *COUCH_HELPER_PATH = "/local/couch/Helper";
+    constexpr const char *COUCH_HELPER_IFACE = "local.couch.Helper";
+
+    /**
+     * @return Whether a window class belongs to a terminal emulator.
+     */
+    bool is_terminal_class(std::string cls) {
+      std::ranges::transform(cls, cls.begin(), [](unsigned char c) {
+        return static_cast<char>(std::tolower(c));
+      });
+      static constexpr std::string_view TERMINALS[] = {"konsole", "alacritty", "org.gnome.console", "kgx", "terminal", "ptyxis", "kitty", "ghostty", "foot", "wezterm", "xterm", "tilix", "terminator", "rio", "contour", "blackbox"};
+      return std::ranges::any_of(TERMINALS, [&cls](std::string_view t) {
+        return cls.find(t) != std::string::npos;
+      });
+    }
+
+    /**
+     * @return Whether a helper's window description (JSON with "wm_class") is a terminal.
+     */
+    bool describes_terminal(std::string_view json) {
+      const auto j = nlohmann::json::parse(json, nullptr, false);
+      if (!j.is_object()) {
+        return false;
+      }
+      return is_terminal_class(j.value("wm_class", std::string {})) || is_terminal_class(j.value("wm_instance", std::string {}));
+    }
+
+    bool is_text_mime(std::string_view mime) {
+      return mime.starts_with("text/plain") || mime == "UTF8_STRING" || mime == "STRING" || mime == "TEXT";
+    }
+
+    bool set_blocking(int fd, bool blocking) {
+      const int flags = fcntl(fd, F_GETFL);
+      if (flags < 0) {
+        return false;
+      }
+      return fcntl(fd, F_SETFL, blocking ? (flags & ~O_NONBLOCK) : (flags | O_NONBLOCK)) == 0;
+    }
+
+    /**
+     * @brief Write everything to a blocking descriptor.
+     */
+    bool write_all(int fd, const std::string &data) {
+      std::size_t off = 0;
+      while (off < data.size()) {
+        const ssize_t n = write(fd, data.data() + off, data.size() - off);
+        if (n < 0) {
+          if (errno == EINTR) {
+            continue;
+          }
+          return false;
+        }
+        off += static_cast<std::size_t>(n);
+      }
+      return true;
+    }
+
+    /**
+     * @brief Read a non-blocking descriptor until EOF, a deadline or the size limit.
+     */
+    std::optional<std::string> read_all(int fd, std::chrono::milliseconds timeout) {
+      std::string out;
+      char buf[64 * 1024];
+      const auto deadline = std::chrono::steady_clock::now() + timeout;
+      for (;;) {
+        const ssize_t n = read(fd, buf, sizeof(buf));
+        if (n > 0) {
+          if (out.size() + static_cast<std::size_t>(n) > MAX_CLIPBOARD_BYTES) {
+            return std::nullopt;
+          }
+          out.append(buf, static_cast<std::size_t>(n));
+          continue;
+        }
+        if (n == 0) {
+          return out;
+        }
+        if (errno == EINTR) {
+          continue;
+        }
+        if (errno != EAGAIN && errno != EWOULDBLOCK) {
+          return std::nullopt;
+        }
+        const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now());
+        if (left <= 0ms) {
+          return std::nullopt;
+        }
+        pollfd pfd {fd, POLLIN, 0};
+        poll(&pfd, 1, static_cast<int>(left.count()));
+      }
+    }
+
+    /**
+     * @brief The process-wide remote desktop session.
+     */
+    class service_t {
+    public:
+      static service_t &instance() {
+        static service_t service;
+        return service;
+      }
+
+      void start() {
+        if (!ensure_thread()) {
+          return;
+        }
+        invoke([this]() {
+          watch_focus();
+          ++users;
+          if (linger_source) {
+            g_source_destroy(linger_source);
+            g_source_unref(linger_source);
+            linger_source = nullptr;
+          }
+          if (session_path().empty()) {
+            create_session();
+            // The initial SelectionOwnerChanged is dispatched before this low-priority idle runs:
+            // what is already on the PC clipboard is not news for the new stream.
+            GSource *idle = g_idle_source_new();
+            g_source_set_priority(idle, G_PRIORITY_LOW);
+            g_source_set_callback(idle, [](gpointer self) -> gboolean {
+              static_cast<service_t *>(self)->reset_baseline();
+              return G_SOURCE_REMOVE;
+            },
+                                  this,
+                                  nullptr);
+            g_source_attach(idle, ctx);
+            g_source_unref(idle);
+          } else {
+            reset_baseline();
+          }
+        });
+      }
+
+      void stop() {
+        if (!ensure_thread()) {
+          return;
+        }
+        invoke([this]() {
+          if (users == 0 || --users > 0 || linger_source) {
+            return;
+          }
+          linger_source = g_timeout_source_new_seconds(LINGER_S);
+          g_source_set_callback(linger_source, [](gpointer self) -> gboolean {
+            auto *s = static_cast<service_t *>(self);
+            g_source_unref(s->linger_source);
+            s->linger_source = nullptr;
+            s->destroy_session();
+            return G_SOURCE_REMOVE;
+          },
+                                this,
+                                nullptr);
+          g_source_attach(linger_source, ctx);
+        });
+      }
+
+      bool scroll(double dx, double dy) {
+        const auto path = session_path();
+        if (path.empty()) {
+          return false;
+        }
+        g_dbus_connection_call(conn, RD_BUS, path.c_str(), SESSION_IFACE, "NotifyPointerAxis", g_variant_new("(ddu)", dx, dy, AXIS_SOURCE_FINGER), nullptr, G_DBUS_CALL_FLAGS_NONE, -1, nullptr, nullptr, nullptr);
+        last_scroll_us = g_get_monotonic_time();
+        if (!finish_pending.exchange(true)) {
+          invoke([this]() {
+            GSource *timer = g_timeout_source_new(SCROLL_FINISH_POLL_MS);
+            g_source_set_callback(timer, [](gpointer self) -> gboolean {
+              return static_cast<service_t *>(self)->maybe_finish_scroll();
+            },
+                                  this,
+                                  nullptr);
+            g_source_attach(timer, ctx);
+            g_source_unref(timer);
+          });
+        }
+        return true;
+      }
+
+      std::optional<clipboard_t> clipboard_get() {
+        std::vector<std::string> mimes;
+        std::string path;
+        std::uint64_t seq_now;
+        {
+          std::lock_guard lg {lock};
+          if (session.empty() || session_owns || seq == baseline_seq) {
+            // Nothing was copied on the PC during this stream.
+            return std::nullopt;
+          }
+          mimes = pc_mimes;
+          path = session;
+          seq_now = seq;
+        }
+
+        auto has = [&mimes](std::string_view m) {
+          return std::ranges::find(mimes, m) != mimes.end();
+        };
+        for (const char *mime : TEXT_READ_ORDER) {
+          if (has(mime)) {
+            auto data = read_selection(path, mime);
+            if (!data) {
+              return std::nullopt;
+            }
+            return clipboard_t {TEXT_MIME, std::move(*data), seq_now};
+          }
+        }
+        if (has(PNG_MIME)) {
+          auto data = read_selection(path, PNG_MIME);
+          if (!data) {
+            return std::nullopt;
+          }
+          return clipboard_t {PNG_MIME, std::move(*data), seq_now};
+        }
+        return std::nullopt;
+      }
+
+      bool clipboard_set(const std::string &mime, std::string data) {
+        const bool text = is_text_mime(mime);
+        if ((!text && mime != PNG_MIME) || data.size() > MAX_CLIPBOARD_BYTES) {
+          return false;
+        }
+
+        std::string path;
+        {
+          std::lock_guard lg {lock};
+          if (session.empty()) {
+            return false;
+          }
+          path = session;
+          own_mime = text ? TEXT_MIME : PNG_MIME;
+          own_data = std::make_shared<const std::string>(std::move(data));
+          session_owns = true;
+        }
+
+        GVariantBuilder offers;
+        g_variant_builder_init(&offers, G_VARIANT_TYPE("as"));
+        if (text) {
+          for (const char *m : TEXT_OFFERS) {
+            g_variant_builder_add(&offers, "s", m);
+          }
+        } else {
+          g_variant_builder_add(&offers, "s", PNG_MIME);
+        }
+        GVariantBuilder options;
+        g_variant_builder_init(&options, G_VARIANT_TYPE("a{sv}"));
+        g_variant_builder_add(&options, "{sv}", "mime-types", g_variant_builder_end(&offers));
+
+        g_autoptr(GError) err = nullptr;
+        g_autoptr(GVariant) r = g_dbus_connection_call_sync(conn, RD_BUS, path.c_str(), SESSION_IFACE, "SetSelection", g_variant_new("(a{sv})", &options), nullptr, G_DBUS_CALL_FLAGS_NONE, CALL_TIMEOUT_MS, nullptr, &err);
+        if (!r) {
+          BOOST_LOG(warning) << "[mutter_rd] SetSelection failed: "sv << (err ? err->message : "unknown");
+          std::lock_guard lg {lock};
+          session_owns = false;
+          own_data.reset();
+          return false;
+        }
+        return true;
+      }
+
+      bool available() {
+        return !session_path().empty();
+      }
+
+      bool terminal_focused() const {
+        return terminal;
+      }
+
+    private:
+      service_t() = default;
+
+      // ---- thread plumbing -------------------------------------------------------------------
+
+      bool ensure_thread() {
+        std::call_once(thread_once, [this]() {
+          ctx = g_main_context_new();
+          std::promise<bool> opened;
+          auto ready = opened.get_future();
+          std::thread([this, opened = std::move(opened)]() mutable {
+            g_main_context_push_thread_default(ctx);
+            opened.set_value(open_connection());
+            GMainLoop *loop = g_main_loop_new(ctx, FALSE);
+            g_main_loop_run(loop);  // runs for the lifetime of the process
+            g_main_loop_unref(loop);
+          }).detach();
+          connected = ready.get();
+        });
+        return connected;
+      }
+
+      bool open_connection() {
+        g_autoptr(GError) err = nullptr;
+        g_autofree gchar *address = g_dbus_address_get_for_bus_sync(G_BUS_TYPE_SESSION, nullptr, &err);
+        if (!address) {
+          BOOST_LOG(info) << "[mutter_rd] No session bus, clipboard sharing and touchpad scrolling disabled"sv;
+          return false;
+        }
+        conn = g_dbus_connection_new_for_address_sync(address, GDBusConnectionFlags(G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION), nullptr, nullptr, &err);
+        if (!conn) {
+          BOOST_LOG(warning) << "[mutter_rd] Session bus connection failed: "sv << (err ? err->message : "unknown");
+          return false;
+        }
+        g_dbus_connection_set_exit_on_close(conn, FALSE);
+        return true;
+      }
+
+      /**
+       * @brief Run @p fn on the main loop thread.
+       *
+       * Always queued (never g_main_context_invoke, which runs the function on the calling
+       * thread when the loop has not acquired its context yet): signal subscriptions made in
+       * there must belong to the loop thread or their callbacks are never dispatched.
+       */
+      void invoke(std::function<void()> fn) {
+        GSource *source = g_idle_source_new();
+        g_source_set_priority(source, G_PRIORITY_DEFAULT);
+        g_source_set_callback(source, [](gpointer data) -> gboolean {
+          (*static_cast<std::function<void()> *>(data))();
+          return G_SOURCE_REMOVE;
+        },
+                              new std::function<void()>(std::move(fn)),
+                              [](gpointer data) {
+                                delete static_cast<std::function<void()> *>(data);
+                              });
+        g_source_attach(source, ctx);
+        g_source_unref(source);
+      }
+
+      std::string session_path() {
+        std::lock_guard lg {lock};
+        return session;
+      }
+
+      GVariant *call(const std::string &path, const char *method, GVariant *params, const GVariantType *reply_type = nullptr) {
+        g_autoptr(GError) err = nullptr;
+        GVariant *r = g_dbus_connection_call_sync(conn, RD_BUS, path.c_str(), path == RD_PATH ? RD_IFACE : SESSION_IFACE, method, params, reply_type, G_DBUS_CALL_FLAGS_NONE, CALL_TIMEOUT_MS, nullptr, &err);
+        if (!r) {
+          BOOST_LOG(warning) << "[mutter_rd] "sv << method << " failed: "sv << (err ? err->message : "unknown");
+        }
+        return r;
+      }
+
+      // ---- session lifecycle (main loop thread) -------------------------------------------
+
+      void create_session() {
+        g_autoptr(GVariant) created = call(RD_PATH, "CreateSession", nullptr, G_VARIANT_TYPE("(o)"));
+        if (!created) {
+          BOOST_LOG(info) << "[mutter_rd] GNOME remote desktop API unavailable; clipboard sharing and touchpad scrolling disabled"sv;
+          return;
+        }
+        const gchar *p = nullptr;
+        g_variant_get(created, "(&o)", &p);
+        std::string path = p;
+
+        subscription = g_dbus_connection_signal_subscribe(conn, nullptr, SESSION_IFACE, nullptr, path.c_str(), nullptr, G_DBUS_SIGNAL_FLAGS_NONE, [](GDBusConnection *, const gchar *, const gchar *, const gchar *, const gchar *signal, GVariant *params, gpointer self) {
+          static_cast<service_t *>(self)->on_signal(signal, params);
+        },
+                                                          this,
+                                                          nullptr);
+
+        g_autoptr(GVariant) started = call(path, "Start", nullptr);
+        if (!started) {
+          g_dbus_connection_signal_unsubscribe(conn, subscription);
+          subscription = 0;
+          return;
+        }
+        {
+          std::lock_guard lg {lock};
+          session = path;
+          pc_mimes.clear();
+          session_owns = false;
+          own_data.reset();
+        }
+        GVariantBuilder none;
+        g_variant_builder_init(&none, G_VARIANT_TYPE("a{sv}"));
+        g_autoptr(GVariant) clip = call(path, "EnableClipboard", g_variant_new("(a{sv})", &none));
+        BOOST_LOG(info) << "[mutter_rd] Remote desktop session ready (clipboard "sv << (clip ? "shared"sv : "unavailable"sv) << ", touchpad scrolling)"sv;
+      }
+
+      void destroy_session() {
+        const auto path = session_path();
+        if (!path.empty()) {
+          g_autoptr(GVariant) r = call(path, "Stop", nullptr);
+        }
+        forget_session();
+      }
+
+      void forget_session() {
+        if (subscription) {
+          g_dbus_connection_signal_unsubscribe(conn, subscription);
+          subscription = 0;
+        }
+        std::lock_guard lg {lock};
+        if (!session.empty()) {
+          BOOST_LOG(info) << "[mutter_rd] Remote desktop session closed"sv;
+        }
+        session.clear();
+        pc_mimes.clear();
+        session_owns = false;
+        own_data.reset();
+      }
+
+      // ---- focused window (main loop thread) -------------------------------------------------
+
+      void watch_focus() {
+        if (!focus_subscription) {
+          focus_subscription = g_dbus_connection_signal_subscribe(conn, nullptr, nullptr, "FocusChanged", nullptr, nullptr, G_DBUS_SIGNAL_FLAGS_NONE, [](GDBusConnection *, const gchar *, const gchar *, const gchar *iface, const gchar *, GVariant *params, gpointer self) {
+            const std::string_view i {iface ? iface : ""};
+            if ((i == LIGHTPATH_HELPER_IFACE || i == COUCH_HELPER_IFACE) && g_variant_is_of_type(params, G_VARIANT_TYPE("(s)"))) {
+              const gchar *json = nullptr;
+              g_variant_get(params, "(&s)", &json);
+              static_cast<service_t *>(self)->terminal = describes_terminal(json);
+            }
+          },
+                                                                  this,
+                                                                  nullptr);
+        }
+        // Where focus is right now (a stream starts while a window already has focus).
+        g_autoptr(GVariant) r = g_dbus_connection_call_sync(conn, SHELL_BUS, LIGHTPATH_HELPER_PATH, LIGHTPATH_HELPER_IFACE, "Focused", nullptr, G_VARIANT_TYPE("(s)"), G_DBUS_CALL_FLAGS_NONE, 500, nullptr, nullptr);
+        if (r) {
+          const gchar *json = nullptr;
+          g_variant_get(r, "(&s)", &json);
+          terminal = describes_terminal(json);
+          return;
+        }
+        g_autoptr(GVariant) list = g_dbus_connection_call_sync(conn, SHELL_BUS, COUCH_HELPER_PATH, COUCH_HELPER_IFACE, "ListWindows", nullptr, G_VARIANT_TYPE("(s)"), G_DBUS_CALL_FLAGS_NONE, 500, nullptr, nullptr);
+        if (!list) {
+          return;
+        }
+        const gchar *json = nullptr;
+        g_variant_get(list, "(&s)", &json);
+        const auto windows = nlohmann::json::parse(json, nullptr, false);
+        bool found = false;
+        if (windows.is_array()) {
+          for (const auto &w : windows) {
+            if (w.is_object() && w.value("focused", false)) {
+              found = describes_terminal(w.dump());
+              break;
+            }
+          }
+        }
+        terminal = found;
+      }
+
+      void reset_baseline() {
+        std::lock_guard lg {lock};
+        baseline_seq = seq;
+      }
+
+      // ---- signals (main loop thread) ------------------------------------------------------
+
+      void on_signal(const gchar *signal, GVariant *params) {
+        const std::string_view name {signal};
+        if (name == "SelectionOwnerChanged") {
+          g_autoptr(GVariant) options = g_variant_get_child_value(params, 0);
+          gboolean is_owner = FALSE;
+          g_variant_lookup(options, "session-is-owner", "b", &is_owner);
+          std::vector<std::string> mimes;
+          // Mutter sends "mime-types" as "(as)" although its interface documentation says "as".
+          g_autoptr(GVariant) value = g_variant_lookup_value(options, "mime-types", nullptr);
+          g_autoptr(GVariant) list = nullptr;
+          if (value && g_variant_is_of_type(value, G_VARIANT_TYPE("(as)"))) {
+            list = g_variant_get_child_value(value, 0);
+          } else if (value && g_variant_is_of_type(value, G_VARIANT_TYPE("as"))) {
+            list = g_variant_ref(value);
+          }
+          if (list) {
+            gsize n = 0;
+            const gchar **strv = g_variant_get_strv(list, &n);
+            mimes.assign(strv, strv + n);
+            g_free(strv);
+          }
+          BOOST_LOG(debug) << "[mutter_rd] Clipboard owner changed ("sv << (is_owner ? "us"sv : "host application"sv) << ", "sv << mimes.size() << " formats)"sv;
+          std::lock_guard lg {lock};
+          if (is_owner) {
+            session_owns = true;
+          } else {
+            pc_mimes = std::move(mimes);
+            session_owns = false;
+            own_data.reset();
+            ++seq;
+          }
+        } else if (name == "SelectionTransfer") {
+          const gchar *mime = nullptr;
+          guint32 serial = 0;
+          g_variant_get(params, "(&su)", &mime, &serial);
+          serve_transfer(mime, serial);
+        } else if (name == "Closed") {
+          forget_session();
+        }
+      }
+
+      void serve_transfer(std::string_view mime, guint32 serial) {
+        std::shared_ptr<const std::string> data;
+        std::string path;
+        {
+          std::lock_guard lg {lock};
+          const bool match = own_data && (own_mime == PNG_MIME ? mime == PNG_MIME : is_text_mime(mime));
+          if (match) {
+            data = own_data;
+          }
+          path = session;
+        }
+        if (path.empty()) {
+          return;
+        }
+        if (!data) {
+          g_dbus_connection_call(conn, RD_BUS, path.c_str(), SESSION_IFACE, "SelectionWriteDone", g_variant_new("(ub)", serial, FALSE), nullptr, G_DBUS_CALL_FLAGS_NONE, -1, nullptr, nullptr, nullptr);
+          return;
+        }
+
+        g_autoptr(GError) err = nullptr;
+        g_autoptr(GUnixFDList) fds = nullptr;
+        g_autoptr(GVariant) r = g_dbus_connection_call_with_unix_fd_list_sync(conn, RD_BUS, path.c_str(), SESSION_IFACE, "SelectionWrite", g_variant_new("(u)", serial), G_VARIANT_TYPE("(h)"), G_DBUS_CALL_FLAGS_NONE, CALL_TIMEOUT_MS, nullptr, &fds, nullptr, &err);
+        int fd = -1;
+        if (r && fds) {
+          gint32 handle = -1;
+          g_variant_get(r, "(h)", &handle);
+          fd = g_unix_fd_list_get(fds, handle, &err);
+        }
+        if (fd < 0) {
+          BOOST_LOG(warning) << "[mutter_rd] SelectionWrite failed: "sv << (err ? err->message : "no descriptor");
+          return;
+        }
+        // The reader may be slow (or a large image): never block the signal loop on it.
+        std::thread([conn = conn, path, serial, fd, data]() {
+          set_blocking(fd, true);
+          const bool ok = write_all(fd, *data);
+          close(fd);
+          g_dbus_connection_call(conn, RD_BUS, path.c_str(), SESSION_IFACE, "SelectionWriteDone", g_variant_new("(ub)", serial, ok), nullptr, G_DBUS_CALL_FLAGS_NONE, -1, nullptr, nullptr, nullptr);
+        }).detach();
+      }
+
+      gboolean maybe_finish_scroll() {
+        if (g_get_monotonic_time() - last_scroll_us < SCROLL_FINISH_AFTER_US) {
+          return G_SOURCE_CONTINUE;
+        }
+        const auto path = session_path();
+        if (!path.empty()) {
+          g_dbus_connection_call(conn, RD_BUS, path.c_str(), SESSION_IFACE, "NotifyPointerAxis", g_variant_new("(ddu)", 0.0, 0.0, AXIS_SOURCE_FINGER | AXIS_FINISH), nullptr, G_DBUS_CALL_FLAGS_NONE, -1, nullptr, nullptr, nullptr);
+        }
+        finish_pending = false;
+        // A delta may have slipped in between the check and the reset: keep watching then.
+        if (g_get_monotonic_time() - last_scroll_us < SCROLL_FINISH_AFTER_US && !finish_pending.exchange(true)) {
+          return G_SOURCE_CONTINUE;
+        }
+        return G_SOURCE_REMOVE;
+      }
+
+      std::optional<std::string> read_selection(const std::string &path, const char *mime) {
+        std::lock_guard rl {read_lock};  // Mutter refuses parallel reads
+        g_autoptr(GError) err = nullptr;
+        g_autoptr(GUnixFDList) fds = nullptr;
+        g_autoptr(GVariant) r = g_dbus_connection_call_with_unix_fd_list_sync(conn, RD_BUS, path.c_str(), SESSION_IFACE, "SelectionRead", g_variant_new("(s)", mime), G_VARIANT_TYPE("(h)"), G_DBUS_CALL_FLAGS_NONE, CALL_TIMEOUT_MS, nullptr, &fds, nullptr, &err);
+        int fd = -1;
+        if (r && fds) {
+          gint32 handle = -1;
+          g_variant_get(r, "(h)", &handle);
+          fd = g_unix_fd_list_get(fds, handle, &err);
+        }
+        if (fd < 0) {
+          BOOST_LOG(warning) << "[mutter_rd] SelectionRead failed: "sv << (err ? err->message : "no descriptor");
+          return std::nullopt;
+        }
+        set_blocking(fd, false);
+        auto data = read_all(fd, READ_TIMEOUT);
+        close(fd);
+        if (!data) {
+          BOOST_LOG(warning) << "[mutter_rd] Clipboard read timed out or exceeded "sv << (MAX_CLIPBOARD_BYTES >> 20) << " MiB"sv;
+        }
+        return data;
+      }
+
+      // ---- state ---------------------------------------------------------------------------
+
+      std::once_flag thread_once;
+      bool connected = false;
+      GMainContext *ctx = nullptr;
+      GDBusConnection *conn = nullptr;  ///< Private connection, constant once opened.
+
+      // Main loop thread only.
+      int users = 0;
+      GSource *linger_source = nullptr;
+      guint subscription = 0;
+      guint focus_subscription = 0;
+
+      // Any thread.
+      std::atomic<gint64> last_scroll_us {0};
+      std::atomic_bool finish_pending {false};
+      std::atomic_bool terminal {false};  ///< The focused window is a terminal.
+      std::mutex read_lock;
+
+      std::mutex lock;  ///< Guards everything below.
+      std::string session;
+      std::vector<std::string> pc_mimes;
+      bool session_owns = false;
+      std::string own_mime;
+      std::shared_ptr<const std::string> own_data;
+      std::uint64_t seq = 1;
+      std::uint64_t baseline_seq = 1;
+    };
+  }  // namespace
+
+  void start() {
+    service_t::instance().start();
+  }
+
+  void stop() {
+    service_t::instance().stop();
+  }
+
+  bool scroll(double dx, double dy) {
+    return service_t::instance().scroll(dx, dy);
+  }
+
+  std::optional<clipboard_t> clipboard_get() {
+    return service_t::instance().clipboard_get();
+  }
+
+  bool clipboard_set(const std::string &mime, std::string data) {
+    return service_t::instance().clipboard_set(mime, std::move(data));
+  }
+
+  bool available() {
+    return service_t::instance().available();
+  }
+
+  bool terminal_focused() {
+    return service_t::instance().terminal_focused();
+  }
+
+  std::string desktop_shortcut(const char *schema, const char *key) {
+    GSettingsSchemaSource *source = g_settings_schema_source_get_default();
+    if (!source) {
+      return {};
+    }
+    g_autoptr(GSettingsSchema) found = g_settings_schema_source_lookup(source, schema, TRUE);
+    if (!found || !g_settings_schema_has_key(found, key)) {
+      return {};
+    }
+    g_autoptr(GSettings) settings = g_settings_new_full(found, nullptr, nullptr);
+    g_auto(GStrv) accels = g_settings_get_strv(settings, key);
+    for (gchar **a = accels; a && *a; ++a) {
+      if (**a) {
+        return *a;
+      }
+    }
+    return {};
+  }
+}  // namespace mutter_rd
diff --git a/src/platform/linux/mutter_rd.h b/src/platform/linux/mutter_rd.h
new file mode 100644
index 0000000..e08ceb8
--- /dev/null
+++ b/src/platform/linux/mutter_rd.h
@@ -0,0 +1,124 @@
+/**
+ * @file src/platform/linux/mutter_rd.h
+ * @brief GNOME (Mutter) remote desktop session: clipboard sharing and touchpad-style scrolling.
+ *
+ * While a stream runs, Sunshine holds one org.gnome.Mutter.RemoteDesktop session. It gives
+ * clients two things uinput cannot:
+ *
+ *  - Clipboard sharing. The PC clipboard can be read and replaced over Mutter's own clipboard
+ *    API (what gnome-remote-desktop uses), so the client can sync copy/paste both ways.
+ *  - Touchpad-quality scrolling. Scroll deltas from a precise client trackpad are injected as
+ *    finger scrolling in logical pixels, so applications scroll 1:1 with the fingers instead of
+ *    animating a mouse wheel notch per event.
+ *
+ * Everything degrades to a no-op when Mutter's API is not available.
+ */
+#pragma once
+
+// standard includes
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace mutter_rd {
+  /**
+   * @brief One clipboard snapshot.
+   */
+  struct clipboard_t {
+    std::string mime;  ///< "text/plain;charset=utf-8" or "image/png".
+    std::string data;  ///< Raw bytes.
+    std::uint64_t seq {};  ///< Increases whenever the PC clipboard changes on the PC side.
+  };
+
+  constexpr std::size_t MAX_CLIPBOARD_BYTES = 16u << 20;  ///< Larger clipboards are not synced.
+
+#ifdef SUNSHINE_BUILD_MUTTER
+  /**
+   * @brief A stream starts: make sure the remote desktop session exists.
+   */
+  void start();
+
+  /**
+   * @brief A stream ended: the session is closed a few seconds after the last stream ends.
+   */
+  void stop();
+
+  /**
+   * @brief Scroll by a precise amount, like two fingers on a touchpad.
+   *
+   * A scroll gesture is finished automatically once deltas stop arriving, which lets
+   * applications start their own kinetic scrolling where they implement it.
+   *
+   * @param dx Horizontal delta in logical pixels, positive scrolls right.
+   * @param dy Vertical delta in logical pixels, positive scrolls down.
+   * @return False when no remote desktop session is available (caller falls back).
+   */
+  bool scroll(double dx, double dy);
+
+  /**
+   * @brief Read the PC clipboard (text preferred, then PNG).
+   *
+   * @return Snapshot, or empty when the clipboard is empty, too large or unavailable.
+   */
+  std::optional<clipboard_t> clipboard_get();
+
+  /**
+   * @brief Replace the PC clipboard.
+   *
+   * @param mime "text/plain;charset=utf-8" (any text/plain) or "image/png".
+   * @param data Content.
+   * @return True when the PC clipboard now offers the content.
+   */
+  bool clipboard_set(const std::string &mime, std::string data);
+
+  /**
+   * @return Whether the focused window is a terminal (Konsole, GNOME Console, Alacritty, ...).
+   *
+   * Known from a GNOME Shell helper extension (Lightpath's, or Couch Helper) that announces
+   * focus changes; false when no helper is running.
+   */
+  bool terminal_focused();
+
+  /**
+   * @brief First accelerator of a GSettings key holding a list of shortcuts.
+   *
+   * @return For example "<Shift>Print"; empty when the schema or key does not exist.
+   */
+  std::string desktop_shortcut(const char *schema, const char *key);
+
+  /**
+   * @return Whether a remote desktop session is currently running.
+   */
+  bool available();
+#else
+  inline void start() {
+  }
+
+  inline void stop() {
+  }
+
+  inline bool scroll(double, double) {
+    return false;
+  }
+
+  inline std::optional<clipboard_t> clipboard_get() {
+    return std::nullopt;
+  }
+
+  inline bool clipboard_set(const std::string &, std::string) {
+    return false;
+  }
+
+  inline bool available() {
+    return false;
+  }
+
+  inline bool terminal_focused() {
+    return false;
+  }
+
+  inline std::string desktop_shortcut(const char *, const char *) {
+    return {};
+  }
+#endif
+}  // namespace mutter_rd
diff --git a/src/platform/linux/muttergrab.cpp b/src/platform/linux/muttergrab.cpp
new file mode 100644
index 0000000..5c57f15
--- /dev/null
+++ b/src/platform/linux/muttergrab.cpp
@@ -0,0 +1,928 @@
+/**
+ * @file src/platform/linux/muttergrab.cpp
+ * @brief GNOME (Mutter) virtual display capture.
+ *
+ * For every stream this backend asks Mutter for a virtual monitor whose single mode is exactly
+ * the resolution and refresh rate the Moonlight client requested, makes it the only active
+ * display while the stream runs and captures it through PipeWire (DMA-BUF, zero-copy into the
+ * encoder). The client therefore receives pixels that were rendered for its own screen: no
+ * scaling on the host, no scaling on the client, no letterboxing, and frames paced by a
+ * compositor clock that runs at the client's refresh rate.
+ *
+ * Mutter's private ScreenCast/DisplayConfig D-Bus APIs are used directly, so no portal dialog,
+ * restore token or permission store juggling is involved. Everything is tied to a private D-Bus
+ * connection: if Sunshine exits or crashes the virtual monitor disappears and Mutter restores the
+ * user's saved physical monitor layout on its own.
+ */
+// standard includes
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdlib>
+#include <mutex>
+#include <optional>
+#include <stop_token>
+#include <string>
+#include <thread>
+#include <vector>
+
+// local includes
+#include "pipewire.cpp"
+
+using namespace std::literals;
+
+namespace mutter {
+  namespace {
+    constexpr const char *SCREENCAST_BUS = "org.gnome.Mutter.ScreenCast";
+    constexpr const char *SCREENCAST_PATH = "/org/gnome/Mutter/ScreenCast";
+    constexpr const char *SCREENCAST_IFACE = "org.gnome.Mutter.ScreenCast";
+    constexpr const char *SESSION_IFACE = "org.gnome.Mutter.ScreenCast.Session";
+    constexpr const char *STREAM_IFACE = "org.gnome.Mutter.ScreenCast.Stream";
+    constexpr const char *DISPLAY_CONFIG_BUS = "org.gnome.Mutter.DisplayConfig";
+    constexpr const char *DISPLAY_CONFIG_PATH = "/org/gnome/Mutter/DisplayConfig";
+    constexpr const char *DISPLAY_CONFIG_IFACE = "org.gnome.Mutter.DisplayConfig";
+    constexpr const char *SESSION_MANAGER_BUS = "org.gnome.SessionManager";
+    constexpr const char *SESSION_MANAGER_PATH = "/org/gnome/SessionManager";
+    constexpr const char *SESSION_MANAGER_IFACE = "org.gnome.SessionManager";
+
+    constexpr uint32_t CURSOR_MODE_EMBEDDED = 1;  ///< Cursor drawn into the frames.
+    constexpr uint32_t APPLY_TEMPORARY = 1;  ///< ApplyMonitorsConfig method: do not touch monitors.xml.
+    constexpr uint32_t INHIBIT_SUSPEND = 4;  ///< org.gnome.SessionManager inhibit flag.
+    constexpr uint32_t INHIBIT_IDLE = 8;  ///< org.gnome.SessionManager inhibit flag.
+    constexpr int DBUS_TIMEOUT_MS = 5000;
+    constexpr uint32_t MIN_API_VERSION = 4;  ///< RecordVirtual "modes" property.
+    constexpr auto STREAM_ADDED_TIMEOUT = 5s;
+    constexpr auto LAYOUT_SETTLE_TIMEOUT = 3s;
+    constexpr auto LINGER = 5s;  ///< Keep the virtual monitor across quick capture re-inits.
+    constexpr auto BLANK_DELAY = 1500ms;  ///< Let the stream start before power-cycling outputs.
+
+    /**
+     * @brief Read an environment variable as a double.
+     *
+     * @param name Variable name.
+     * @return Parsed value, or empty when unset/invalid.
+     */
+    std::optional<double> env_double(const char *name) {
+      const char *value = std::getenv(name);
+      if (!value || !*value) {
+        return std::nullopt;
+      }
+      char *end = nullptr;
+      const double parsed = std::strtod(value, &end);
+      if (end == value || !std::isfinite(parsed)) {
+        return std::nullopt;
+      }
+      return parsed;
+    }
+
+    /**
+     * @brief Read an environment variable as a boolean flag.
+     *
+     * @param name Variable name.
+     * @return True for 1/true/yes/on.
+     */
+    bool env_flag(const char *name) {
+      const char *value = std::getenv(name);
+      if (!value) {
+        return false;
+      }
+      const std::string_view v {value};
+      return v == "1" || v == "true" || v == "yes" || v == "on";
+    }
+  }  // namespace
+
+  /**
+   * @brief A single monitor mode as reported by DisplayConfig.GetCurrentState.
+   */
+  struct mode_info_t {
+    std::string id;  ///< Mode id used by ApplyMonitorsConfig.
+    int width = 0;  ///< Width in pixels.
+    int height = 0;  ///< Height in pixels.
+    double refresh = 0;  ///< Refresh rate in Hz.
+    double preferred_scale = 1;  ///< Mutter's own scale heuristic for this mode.
+    std::vector<double> supported_scales;  ///< Scales Mutter accepts for this mode.
+    bool is_current = false;  ///< Whether the mode is active.
+  };
+
+  /**
+   * @brief A physical or virtual monitor as reported by DisplayConfig.GetCurrentState.
+   */
+  struct monitor_info_t {
+    std::string connector;  ///< Connector name, e.g. "HDMI-1" or "Meta-0".
+    std::string vendor;  ///< Vendor string ("MetaVendor" for virtual monitors).
+    std::vector<mode_info_t> modes;  ///< Available modes.
+  };
+
+  /**
+   * @brief Snapshot of Mutter's monitor configuration.
+   */
+  struct display_state_t {
+    uint32_t serial = 0;  ///< Configuration serial required by ApplyMonitorsConfig.
+    std::vector<monitor_info_t> monitors;  ///< All connected monitors.
+    std::vector<std::string> active_connectors;  ///< Connectors that are part of a logical monitor.
+    std::string primary_connector;  ///< First connector of the primary logical monitor.
+
+    /**
+     * @brief Find a monitor by connector.
+     *
+     * @param connector Connector name.
+     * @return Monitor or nullptr.
+     */
+    const monitor_info_t *find(std::string_view connector) const {
+      for (const auto &monitor : monitors) {
+        if (monitor.connector == connector) {
+          return &monitor;
+        }
+      }
+      return nullptr;
+    }
+  };
+
+  /**
+   * @brief Owned GDBusConnection with RAII close semantics.
+   */
+  class connection_t {
+  public:
+    connection_t() = default;
+    connection_t(const connection_t &) = delete;
+    connection_t &operator=(const connection_t &) = delete;
+
+    ~connection_t() {
+      if (conn) {
+        g_dbus_connection_close_sync(conn, nullptr, nullptr);
+        g_object_unref(conn);
+      }
+    }
+
+    /**
+     * @brief Open a private session bus connection.
+     *
+     * A private connection makes Mutter clean up the virtual monitor as soon as it is closed, no
+     * matter how Sunshine goes away.
+     *
+     * @return True on success.
+     */
+    bool open() {
+      g_autoptr(GError) err = nullptr;
+      g_autofree gchar *address = g_dbus_address_get_for_bus_sync(G_BUS_TYPE_SESSION, nullptr, &err);
+      if (!address) {
+        BOOST_LOG(error) << "[muttergrab] No session bus: "sv << (err ? err->message : "unknown");
+        return false;
+      }
+      conn = g_dbus_connection_new_for_address_sync(
+        address,
+        GDBusConnectionFlags(G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION),
+        nullptr,
+        nullptr,
+        &err
+      );
+      if (!conn) {
+        BOOST_LOG(error) << "[muttergrab] Could not connect to session bus: "sv << err->message;
+        return false;
+      }
+      g_dbus_connection_set_exit_on_close(conn, FALSE);
+      return true;
+    }
+
+    /**
+     * @brief Synchronous D-Bus method call.
+     *
+     * @param bus Destination bus name.
+     * @param path Object path.
+     * @param iface Interface.
+     * @param method Method name.
+     * @param params Parameters (floating references are consumed), may be null.
+     * @param reply_type Expected reply type, may be null.
+     * @return Reply, or nullptr on error (logged).
+     */
+    GVariant *call(const char *bus, const char *path, const char *iface, const char *method, GVariant *params, const GVariantType *reply_type) const {
+      g_autoptr(GError) err = nullptr;
+      GVariant *reply = g_dbus_connection_call_sync(conn, bus, path, iface, method, params, reply_type, G_DBUS_CALL_FLAGS_NONE, DBUS_TIMEOUT_MS, nullptr, &err);
+      if (!reply) {
+        BOOST_LOG(warning) << "[muttergrab] "sv << iface << '.' << method << " failed: "sv << (err ? err->message : "unknown");
+      }
+      return reply;
+    }
+
+    GDBusConnection *conn = nullptr;  ///< Underlying connection.
+  };
+
+  /**
+   * @brief Query Mutter's current monitor configuration.
+   *
+   * @param conn D-Bus connection.
+   * @return Parsed state, or empty on error.
+   */
+  std::optional<display_state_t> get_display_state(const connection_t &conn) {
+    g_autoptr(GVariant) reply = conn.call(DISPLAY_CONFIG_BUS, DISPLAY_CONFIG_PATH, DISPLAY_CONFIG_IFACE, "GetCurrentState", nullptr, G_VARIANT_TYPE("(ua((ssss)a(siiddada{sv})a{sv})a(iiduba(ssss)a{sv})a{sv})"));
+    if (!reply) {
+      return std::nullopt;
+    }
+
+    display_state_t state;
+    g_variant_get_child(reply, 0, "u", &state.serial);
+
+    g_autoptr(GVariant) monitors = g_variant_get_child_value(reply, 1);
+    for (gsize i = 0; i < g_variant_n_children(monitors); ++i) {
+      g_autoptr(GVariant) monitor = g_variant_get_child_value(monitors, i);
+      monitor_info_t info;
+      const gchar *connector = nullptr;
+      const gchar *vendor = nullptr;
+      g_autoptr(GVariant) spec = g_variant_get_child_value(monitor, 0);
+      g_variant_get(spec, "(&s&s&s&s)", &connector, &vendor, nullptr, nullptr);
+      info.connector = connector;
+      info.vendor = vendor;
+
+      g_autoptr(GVariant) modes = g_variant_get_child_value(monitor, 1);
+      for (gsize m = 0; m < g_variant_n_children(modes); ++m) {
+        g_autoptr(GVariant) mode = g_variant_get_child_value(modes, m);
+        mode_info_t mi;
+        const gchar *id = nullptr;
+        g_autoptr(GVariant) scales = nullptr;
+        g_autoptr(GVariant) props = nullptr;
+        g_variant_get(mode, "(&siidd@ad@a{sv})", &id, &mi.width, &mi.height, &mi.refresh, &mi.preferred_scale, &scales, &props);
+        mi.id = id;
+        gsize n_scales = 0;
+        const auto *scale_values = static_cast<const double *>(g_variant_get_fixed_array(scales, &n_scales, sizeof(double)));
+        mi.supported_scales.assign(scale_values, scale_values + n_scales);
+        gboolean is_current = FALSE;
+        if (g_variant_lookup(props, "is-current", "b", &is_current)) {
+          mi.is_current = is_current;
+        }
+        info.modes.emplace_back(std::move(mi));
+      }
+      state.monitors.emplace_back(std::move(info));
+    }
+
+    g_autoptr(GVariant) logical = g_variant_get_child_value(reply, 2);
+    for (gsize i = 0; i < g_variant_n_children(logical); ++i) {
+      g_autoptr(GVariant) lm = g_variant_get_child_value(logical, i);
+      gboolean primary = FALSE;
+      g_variant_get_child(lm, 4, "b", &primary);
+      g_autoptr(GVariant) lm_monitors = g_variant_get_child_value(lm, 5);
+      for (gsize m = 0; m < g_variant_n_children(lm_monitors); ++m) {
+        g_autoptr(GVariant) spec = g_variant_get_child_value(lm_monitors, m);
+        const gchar *connector = nullptr;
+        g_variant_get(spec, "(&s&s&s&s)", &connector, nullptr, nullptr, nullptr);
+        state.active_connectors.emplace_back(connector);
+        if (primary && state.primary_connector.empty()) {
+          state.primary_connector = connector;
+        }
+      }
+    }
+
+    return state;
+  }
+
+  /**
+   * @brief Requested virtual monitor mode.
+   */
+  struct mode_request_t {
+    int width;  ///< Width in pixels.
+    int height;  ///< Height in pixels.
+    double refresh;  ///< Refresh rate in Hz.
+
+    /**
+     * @brief Compare two mode requests.
+     *
+     * @param other Other request.
+     * @return True when equal.
+     */
+    bool operator==(const mode_request_t &other) const {
+      return width == other.width && height == other.height && std::abs(refresh - other.refresh) < 0.01;
+    }
+  };
+
+  /**
+   * @brief A Mutter screencast session producing one PipeWire node.
+   *
+   * Either a virtual monitor (stream mode) or a recording of an existing monitor (encoder probe
+   * mode, which must not disturb the user's screens).
+   */
+  class screencast_session_t {
+  public:
+    screencast_session_t() = default;
+    screencast_session_t(const screencast_session_t &) = delete;
+    screencast_session_t &operator=(const screencast_session_t &) = delete;
+
+    ~screencast_session_t() {
+      if (!session_path.empty() && conn.conn && !g_dbus_connection_is_closed(conn.conn)) {
+        g_autoptr(GVariant) r = conn.call(SCREENCAST_BUS, session_path.c_str(), SESSION_IFACE, "Stop", nullptr, nullptr);
+      }
+      if (inhibit_cookie && conn.conn && !g_dbus_connection_is_closed(conn.conn)) {
+        g_autoptr(GVariant) r = conn.call(SESSION_MANAGER_BUS, SESSION_MANAGER_PATH, SESSION_MANAGER_IFACE, "Uninhibit", g_variant_new("(u)", inhibit_cookie), nullptr);
+      }
+      if (!connector.empty()) {
+        BOOST_LOG(info) << "[muttergrab] Virtual display "sv << connector << " removed; Mutter restores the saved monitor layout"sv;
+      }
+    }
+
+    /**
+     * @brief Create a virtual monitor with exactly one mode and start streaming it.
+     *
+     * @param mode Requested mode.
+     * @return True on success.
+     */
+    bool start_virtual(const mode_request_t &mode) {
+      if (!open_session()) {
+        return false;
+      }
+      const auto before = get_display_state(conn);
+      if (!before) {
+        return false;
+      }
+
+      GVariantBuilder mode_builder;
+      g_variant_builder_init(&mode_builder, G_VARIANT_TYPE("a{sv}"));
+      g_variant_builder_add(&mode_builder, "{sv}", "size", g_variant_new("(uu)", static_cast<uint32_t>(mode.width), static_cast<uint32_t>(mode.height)));
+      g_variant_builder_add(&mode_builder, "{sv}", "refresh-rate", g_variant_new_double(mode.refresh));
+      g_variant_builder_add(&mode_builder, "{sv}", "is-preferred", g_variant_new_boolean(TRUE));
+      GVariantBuilder modes_builder;
+      g_variant_builder_init(&modes_builder, G_VARIANT_TYPE("aa{sv}"));
+      g_variant_builder_add_value(&modes_builder, g_variant_builder_end(&mode_builder));
+
+      GVariantBuilder props;
+      g_variant_builder_init(&props, G_VARIANT_TYPE("a{sv}"));
+      g_variant_builder_add(&props, "{sv}", "cursor-mode", g_variant_new_uint32(CURSOR_MODE_EMBEDDED));
+      g_variant_builder_add(&props, "{sv}", "is-platform", g_variant_new_boolean(TRUE));
+      g_variant_builder_add(&props, "{sv}", "modes", g_variant_builder_end(&modes_builder));
+
+      g_autoptr(GVariant) reply = conn.call(SCREENCAST_BUS, session_path.c_str(), SESSION_IFACE, "RecordVirtual", g_variant_new("(a{sv})", &props), G_VARIANT_TYPE("(o)"));
+      if (!reply) {
+        return false;
+      }
+      stream_path = get_object_path(reply);
+
+      // The monitor is created when the session starts; then find the connector it got.
+      if (!start_and_wait_for_node()) {
+        return false;
+      }
+      const auto deadline = std::chrono::steady_clock::now() + LAYOUT_SETTLE_TIMEOUT;
+      while (connector.empty() && std::chrono::steady_clock::now() < deadline) {
+        if (const auto after = get_display_state(conn)) {
+          for (const auto &monitor : after->monitors) {
+            if (!before->find(monitor.connector) && monitor.connector.starts_with("Meta-")) {
+              connector = monitor.connector;
+            }
+          }
+        }
+        if (connector.empty()) {
+          std::this_thread::sleep_for(10ms);
+        }
+      }
+      if (connector.empty()) {
+        BOOST_LOG(error) << "[muttergrab] Mutter did not create a virtual monitor"sv;
+        return false;
+      }
+
+      inhibit_idle();
+      width = mode.width;
+      height = mode.height;
+      BOOST_LOG(info) << "[muttergrab] Virtual display "sv << connector << " created: "sv << mode.width << 'x' << mode.height << '@' << mode.refresh << "Hz (PipeWire node "sv << node_id << ')';
+      return true;
+    }
+
+    /**
+     * @brief Record an existing monitor (used while probing encoders).
+     *
+     * @param monitor_connector Connector to record.
+     * @return True on success.
+     */
+    bool start_monitor(const std::string &monitor_connector) {
+      if (!open_session()) {
+        return false;
+      }
+      GVariantBuilder props;
+      g_variant_builder_init(&props, G_VARIANT_TYPE("a{sv}"));
+      g_variant_builder_add(&props, "{sv}", "cursor-mode", g_variant_new_uint32(CURSOR_MODE_EMBEDDED));
+      g_autoptr(GVariant) reply = conn.call(SCREENCAST_BUS, session_path.c_str(), SESSION_IFACE, "RecordMonitor", g_variant_new("(sa{sv})", monitor_connector.c_str(), &props), G_VARIANT_TYPE("(o)"));
+      if (!reply) {
+        return false;
+      }
+      stream_path = get_object_path(reply);
+      return start_and_wait_for_node();
+    }
+
+    /**
+     * @brief Make the virtual monitor the only (and primary) display.
+     *
+     * The change is temporary: monitors.xml is not touched, and as soon as the virtual monitor
+     * disappears Mutter falls back to the saved configuration for the physical monitors.
+     *
+     * @return True on success.
+     */
+    bool make_exclusive() {
+      for (int attempt = 0; attempt < 3; ++attempt) {
+        const auto state = get_display_state(conn);
+        if (!state) {
+          return false;
+        }
+        const auto *monitor = state->find(connector);
+        if (!monitor || monitor->modes.empty()) {
+          BOOST_LOG(error) << "[muttergrab] Virtual monitor "sv << connector << " vanished"sv;
+          return false;
+        }
+        const auto mode_it = std::ranges::find_if(monitor->modes, [](const auto &m) {
+          return m.is_current;
+        });
+        const auto &mode = mode_it != monitor->modes.end() ? *mode_it : monitor->modes.front();
+        scale = pick_scale(mode);
+
+        GVariantBuilder monitors;
+        g_variant_builder_init(&monitors, G_VARIANT_TYPE("a(ssa{sv})"));
+        g_variant_builder_add(&monitors, "(ss@a{sv})", connector.c_str(), mode.id.c_str(), g_variant_new_array(G_VARIANT_TYPE("{sv}"), nullptr, 0));
+        GVariantBuilder logical;
+        g_variant_builder_init(&logical, G_VARIANT_TYPE("a(iiduba(ssa{sv}))"));
+        g_variant_builder_add(&logical, "(iidub@a(ssa{sv}))", 0, 0, scale, 0u, TRUE, g_variant_builder_end(&monitors));
+
+        g_autoptr(GError) err = nullptr;
+        g_autoptr(GVariant) reply = g_dbus_connection_call_sync(
+          conn.conn,
+          DISPLAY_CONFIG_BUS,
+          DISPLAY_CONFIG_PATH,
+          DISPLAY_CONFIG_IFACE,
+          "ApplyMonitorsConfig",
+          g_variant_new("(uu@a(iiduba(ssa{sv}))@a{sv})", state->serial, APPLY_TEMPORARY, g_variant_builder_end(&logical), g_variant_new_array(G_VARIANT_TYPE("{sv}"), nullptr, 0)),
+          nullptr,
+          G_DBUS_CALL_FLAGS_NONE,
+          DBUS_TIMEOUT_MS,
+          nullptr,
+          &err
+        );
+        if (reply) {
+          BOOST_LOG(info) << "[muttergrab] "sv << connector << " is now the only display (scale "sv << scale << ')';
+          detached_physical = std::ranges::any_of(state->active_connectors, [this](const auto &c) {
+            return c != connector && !c.starts_with("Meta-");
+          });
+          return true;
+        }
+        // A monitor hotplug between GetCurrentState and ApplyMonitorsConfig makes the serial stale; retry.
+        BOOST_LOG(warning) << "[muttergrab] ApplyMonitorsConfig failed (attempt "sv << attempt + 1 << "): "sv << (err ? err->message : "unknown");
+        std::this_thread::sleep_for(100ms);
+      }
+      return false;
+    }
+
+    /**
+     * @brief Wait until Wayland clients (including Sunshine's input mapping) see the new layout.
+     *
+     * @param expect_exclusive Whether the virtual monitor should be the only output.
+     */
+    void wait_for_layout(bool expect_exclusive) const {
+      const int logical_w = static_cast<int>(std::lround(width / scale));
+      const int logical_h = static_cast<int>(std::lround(height / scale));
+      const auto deadline = std::chrono::steady_clock::now() + LAYOUT_SETTLE_TIMEOUT;
+      while (std::chrono::steady_clock::now() < deadline) {
+        const auto outputs = wl::monitors();
+        const bool found = std::ranges::any_of(outputs, [&](const auto &m) {
+          return m->name == connector && m->viewport.logical_width == logical_w && m->viewport.logical_height == logical_h;
+        });
+        if (found && (!expect_exclusive || outputs.size() == 1)) {
+          return;
+        }
+        std::this_thread::sleep_for(20ms);
+      }
+      BOOST_LOG(warning) << "[muttergrab] Timed out waiting for the Wayland output layout to settle"sv;
+    }
+
+    connection_t conn;  ///< Private D-Bus connection owning the session.
+    std::string session_path;  ///< Mutter ScreenCast session object path.
+    std::string stream_path;  ///< Mutter ScreenCast stream object path.
+    std::string connector;  ///< Virtual monitor connector (empty in probe mode).
+    uint32_t node_id = PW_ID_ANY;  ///< PipeWire node of the stream.
+    int width = 0;  ///< Virtual monitor width.
+    int height = 0;  ///< Virtual monitor height.
+    double scale = 1;  ///< Applied logical monitor scale.
+    uint32_t inhibit_cookie = 0;  ///< Session manager inhibitor cookie.
+    bool detached_physical = false;  ///< Whether make_exclusive() removed physical outputs.
+
+  private:
+    /**
+     * @brief Connect and create a ScreenCast session.
+     *
+     * @return True on success.
+     */
+    bool open_session() {
+      if (!conn.open()) {
+        return false;
+      }
+      g_autoptr(GVariant) version = conn.call(SCREENCAST_BUS, SCREENCAST_PATH, "org.freedesktop.DBus.Properties", "Get", g_variant_new("(ss)", SCREENCAST_IFACE, "Version"), G_VARIANT_TYPE("(v)"));
+      if (!version) {
+        return false;
+      }
+      g_autoptr(GVariant) inner = nullptr;
+      g_variant_get(version, "(v)", &inner);
+      if (const auto api = g_variant_get_int32(inner); api < static_cast<int32_t>(MIN_API_VERSION)) {
+        BOOST_LOG(error) << "[muttergrab] Mutter ScreenCast API version "sv << api << " is too old (need "sv << MIN_API_VERSION << ", GNOME 46 or newer)"sv;
+        return false;
+      }
+      g_autoptr(GVariant) reply = conn.call(SCREENCAST_BUS, SCREENCAST_PATH, SCREENCAST_IFACE, "CreateSession", g_variant_new("(a{sv})", nullptr), G_VARIANT_TYPE("(o)"));
+      if (!reply) {
+        return false;
+      }
+      session_path = get_object_path(reply);
+      return true;
+    }
+
+    /**
+     * @brief Start the session and wait for the PipeWire node announcement.
+     *
+     * @return True once the node id is known.
+     */
+    bool start_and_wait_for_node() {
+      GMainContext *context = g_main_context_new();
+      g_main_context_push_thread_default(context);
+      const guint subscription = g_dbus_connection_signal_subscribe(
+        conn.conn,
+        nullptr,
+        STREAM_IFACE,
+        "PipeWireStreamAdded",
+        stream_path.c_str(),
+        nullptr,
+        G_DBUS_SIGNAL_FLAGS_NONE,
+        [](GDBusConnection *, const gchar *, const gchar *, const gchar *, const gchar *, GVariant *parameters, gpointer user_data) {
+          g_variant_get(parameters, "(u)", static_cast<uint32_t *>(user_data));
+        },
+        &node_id,
+        nullptr
+      );
+
+      g_autoptr(GVariant) started = conn.call(SCREENCAST_BUS, session_path.c_str(), SESSION_IFACE, "Start", nullptr, nullptr);
+      const auto deadline = std::chrono::steady_clock::now() + STREAM_ADDED_TIMEOUT;
+      while (started && node_id == PW_ID_ANY && std::chrono::steady_clock::now() < deadline) {
+        if (!g_main_context_iteration(context, FALSE)) {
+          std::this_thread::sleep_for(2ms);
+        }
+      }
+
+      g_dbus_connection_signal_unsubscribe(conn.conn, subscription);
+      while (g_main_context_iteration(context, FALSE)) {
+      }
+      g_main_context_pop_thread_default(context);
+      g_main_context_unref(context);
+
+      if (node_id == PW_ID_ANY) {
+        BOOST_LOG(error) << "[muttergrab] Mutter did not announce a PipeWire stream"sv;
+        return false;
+      }
+      return true;
+    }
+
+    /**
+     * @brief Keep GNOME from blanking or suspending while a client is watching.
+     *
+     * Also tells other session tools (e.g. auto-sleep daemons that honour inhibitors) that the
+     * machine is in use.
+     */
+    void inhibit_idle() {
+      g_autoptr(GVariant) reply = conn.call(SESSION_MANAGER_BUS, SESSION_MANAGER_PATH, SESSION_MANAGER_IFACE, "Inhibit", g_variant_new("(susu)", "sunshine", 0u, "Streaming to a Moonlight client", INHIBIT_IDLE | INHIBIT_SUSPEND), G_VARIANT_TYPE("(u)"));
+      if (reply) {
+        g_variant_get(reply, "(u)", &inhibit_cookie);
+      }
+    }
+
+    /**
+     * @brief Pick the logical scale for the virtual monitor.
+     *
+     * Defaults to Mutter's own heuristic for the mode (2x for Retina-class resolutions, which is
+     * what macOS uses as well), overridable with SUNSHINE_MUTTER_SCALE.
+     *
+     * @param mode Current mode of the virtual monitor.
+     * @return A scale Mutter accepts for that mode.
+     */
+    static double pick_scale(const mode_info_t &mode) {
+      const double wanted = env_double("SUNSHINE_MUTTER_SCALE").value_or(mode.preferred_scale);
+      if (mode.supported_scales.empty()) {
+        return 1.0;
+      }
+      return *std::ranges::min_element(mode.supported_scales, [wanted](double a, double b) {
+        return std::abs(a - wanted) < std::abs(b - wanted);
+      });
+    }
+
+    /**
+     * @brief Extract the object path from a "(o)" reply.
+     *
+     * @param reply Reply variant.
+     * @return Object path.
+     */
+    static std::string get_object_path(GVariant *reply) {
+      const gchar *path = nullptr;
+      g_variant_get(reply, "(&o)", &path);
+      return path;
+    }
+  };
+
+  /**
+   * @brief Turn off physical outputs that were removed from the layout, once the stream runs.
+   *
+   * Some drivers (NVIDIA) keep scanning out the last frame of a monitor that is no longer part
+   * of the layout, so a projector or TV would show a frozen picture for the whole stream. A
+   * display power-save cycle makes Mutter re-enable only the outputs that are still configured.
+   * It is done a moment after capture started, from a separate thread and D-Bus connection,
+   * so it never delays the first frame; the stream sees at most a sub-second hiccup.
+   *
+   * @param weak Session that detached the outputs; nothing happens if it is already gone.
+   */
+  void blank_detached_outputs_later(std::weak_ptr<screencast_session_t> weak) {
+    std::thread([weak = std::move(weak)]() {
+      std::this_thread::sleep_for(BLANK_DELAY);
+      const auto session = weak.lock();
+      if (!session) {
+        return;
+      }
+      connection_t conn;
+      if (!conn.open()) {
+        return;
+      }
+      const auto start = std::chrono::steady_clock::now();
+      for (const int mode : {3, 0}) {
+        g_autoptr(GVariant) r = conn.call(DISPLAY_CONFIG_BUS, DISPLAY_CONFIG_PATH, "org.freedesktop.DBus.Properties", "Set", g_variant_new("(ssv)", DISPLAY_CONFIG_IFACE, "PowerSaveMode", g_variant_new_int32(mode)), nullptr);
+      }
+      const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+      BOOST_LOG(info) << "[muttergrab] Switched off the physical displays removed from the layout ("sv << ms << " ms)"sv;
+    }).detach();
+  }
+
+  /**
+   * @brief Shares one virtual monitor between consecutive capture objects of a stream.
+   *
+   * Sunshine recreates its display object on capture re-initialisation. Tearing the virtual
+   * monitor down every time would bounce all windows to the physical screen and back, so the
+   * monitor lingers for a few seconds after the last user releases it and is reused when the
+   * next request asks for the same mode.
+   */
+  class virtual_display_pool_t {
+  public:
+    virtual_display_pool_t():
+        reaper([this](std::stop_token stop) {
+          reap(stop);
+        }) {
+    }
+
+    ~virtual_display_pool_t() {
+      reaper.request_stop();
+      cv.notify_all();
+    }
+
+    /**
+     * @brief Get a virtual monitor for the requested mode.
+     *
+     * @param mode Requested mode.
+     * @return Session, or nullptr on failure.
+     */
+    std::shared_ptr<screencast_session_t> acquire(const mode_request_t &mode) {
+      std::unique_lock lock(mutex);
+      if (current && current_mode == mode) {
+        ++users;
+        release_at.reset();
+        BOOST_LOG(info) << "[muttergrab] Reusing virtual display "sv << current->connector;
+        return current;
+      }
+      current.reset();  // Different mode: drop the old monitor first.
+
+      auto session = std::make_shared<screencast_session_t>();
+      if (!session->start_virtual(mode)) {
+        return nullptr;
+      }
+      if (!env_flag("SUNSHINE_MUTTER_KEEP_PHYSICAL")) {
+        if (!session->make_exclusive()) {
+          BOOST_LOG(warning) << "[muttergrab] Could not make the virtual display exclusive; it will extend the desktop instead"sv;
+        }
+        session->wait_for_layout(true);
+        if (session->detached_physical && !env_flag("SUNSHINE_MUTTER_NO_BLANK")) {
+          blank_detached_outputs_later(session);
