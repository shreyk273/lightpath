+}
+
+TEST(MacKeymapTest, ScreenshotsUseThePcShortcuts) {
+  harness_t h;
+  h.t.set_screenshot_shortcuts(*parse_accel("<Shift>Print"), *parse_accel("<Shift><Super>s"));
+  h.shift = true;
+  h.press(vk::LWIN);
+  h.press(vk::KEY_3);
+  h.release(vk::KEY_3);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), up(vk::RCONTROL), down(0x2C), up(0x2C), down(vk::RCONTROL)}));
+  h.press(vk::KEY_4);
+  h.release(vk::KEY_4);
