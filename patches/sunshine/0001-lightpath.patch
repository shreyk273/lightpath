+/**
+ * @brief Random client key storms never leave a host key stuck or released twice.
+ */
+TEST(MacKeymapTest, RandomSequencesNeverStickOrDoubleRelease) {
+  const std::vector<std::uint16_t> keys {vk::LWIN, vk::RWIN, vk::LMENU, vk::RMENU, vk::LCONTROL, vk::RCONTROL, vk::KEY_3, vk::KEY_4, vk::KEY_U, KEY_A, KEY_C, KEY_V, vk::TAB, vk::OEM_3, vk::LEFT, vk::RIGHT, vk::UP, vk::DOWN, vk::BACK, vk::DEL, vk::SPACE, vk::KEY_H, vk::KEY_M, vk::OEM_4, vk::OEM_6};
+  std::mt19937 rng {1234};
+
+  for (int round = 0; round < 2000; ++round) {
+    translator_t t;
+    t.set_terminal(rng() % 2);
+    std::set<std::uint16_t> client_down;
+    std::map<std::uint16_t, int> host_down;  // what the translator pressed on the host
+    bool shift = rng() % 2;
+
+    auto apply = [&](const events_t &out) {
+      for (const auto &e : out) {
+        if (e.release && (e.vk == vk::LSHIFT || e.vk == vk::RSHIFT) && host_down[e.vk] == 0) {
+          continue;  // letting go of the client's own Shift for a screenshot shortcut
+        }
+        if (e.release) {
+          ASSERT_EQ(host_down[e.vk], 1) << "released a host key that was not down: " << e.vk;
+          host_down[e.vk] = 0;
+        } else {
+          ASSERT_EQ(host_down[e.vk], 0) << "pressed a host key twice: " << e.vk;
+          host_down[e.vk] = 1;
+        }
+      }
+    };
+
+    for (int step = 0; step < 40; ++step) {
+      const auto code = keys[rng() % keys.size()];
+      const bool release = client_down.contains(code) ? (rng() % 3 != 0) : false;  // sometimes a lost release
+      events_t out;
+      if (rng() % 31 == 0) {
+        t.pointer_used();
+      } else if (rng() % 17 == 0) {
+        t.pointer_button(out);
+      } else {
+        t.key(code, release, shift, out);
+        if (release) {
+          client_down.erase(code);
+        } else {
+          client_down.insert(code);
+        }
+      }
+      apply(out);
+    }
+
+    // The user lets go of everything, in random order.
+    std::vector<std::uint16_t> remaining(client_down.begin(), client_down.end());
+    std::shuffle(remaining.begin(), remaining.end(), rng);
+    for (const auto code : remaining) {
+      events_t out;
+      t.key(code, true, shift, out);
+      apply(out);
+    }
+
+    for (const auto &[code, n] : host_down) {
+      ASSERT_EQ(n, 0) << "host key stuck after all client keys were released: " << code << " (round " << round << ')';
+    }
+  }
+}
