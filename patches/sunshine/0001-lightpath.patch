+        return false;
+      }
+      stream_path = get_object_path(reply);
+      return start_and_wait_for_node();
+    }
+
+    /**
+     * @brief Make the virtual monitor the only (and primary) display.
+     *
+     * The change is temporary: monitors.xml is not touched, and as soon as the virtual monitor
+     * disappears Mutter falls back to the saved configuration for the physical monitors.
+     *
+     * @return True on success.
+     */
+    bool make_exclusive() {
+      for (int attempt = 0; attempt < 3; ++attempt) {
+        const auto state = get_display_state(conn);
+        if (!state) {
+          return false;
+        }
+        const auto *monitor = state->find(connector);
+        if (!monitor || monitor->modes.empty()) {
+          BOOST_LOG(error) << "[muttergrab] Virtual monitor "sv << connector << " vanished"sv;
+          return false;
+        }
+        const auto mode_it = std::ranges::find_if(monitor->modes, [](const auto &m) {
+          return m.is_current;
+        });
