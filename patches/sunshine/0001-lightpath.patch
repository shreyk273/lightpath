+        return false;
+      }
+      GVariantBuilder props;
+      g_variant_builder_init(&props, G_VARIANT_TYPE("a{sv}"));
+      g_variant_builder_add(&props, "{sv}", "cursor-mode", g_variant_new_uint32(CURSOR_MODE_EMBEDDED));
+      g_autoptr(GVariant) reply = conn.call(SCREENCAST_BUS, session_path.c_str(), SESSION_IFACE, "RecordMonitor", g_variant_new("(sa{sv})", monitor_connector.c_str(), &props), G_VARIANT_TYPE("(o)"));
