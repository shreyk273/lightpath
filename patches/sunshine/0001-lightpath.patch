+TEST(MacKeymapTest, ScreenshotToolWithoutShiftLetsGoOfShift) {
+  harness_t h;  // GNOME defaults: Print opens the tool
+  h.shift = true;
+  h.press(vk::LWIN);
+  h.press(vk::KEY_5);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), up(vk::RCONTROL), up(vk::LSHIFT), up(vk::RSHIFT), down(0x2C), up(0x2C), down(vk::RCONTROL)}));
+}
+
+TEST(MacKeymapTest, ParsesDesktopAccelerators) {
+  EXPECT_EQ(parse_accel("<Shift><Super>s"), (chord_t {false, false, true, true, 0x53}));
+  EXPECT_EQ(parse_accel("<Control><Alt>T"), (chord_t {true, true, false, false, 0x54}));
+  EXPECT_EQ(parse_accel("Print"), (chord_t {false, false, false, false, 0x2C}));
+  EXPECT_EQ(parse_accel("<Super>F12"), (chord_t {false, false, true, false, 0x7B}));
+  EXPECT_EQ(parse_accel("<Super>1"), (chord_t {false, false, true, false, 0x31}));
+  EXPECT_FALSE(parse_accel("<Hyper>a"));
