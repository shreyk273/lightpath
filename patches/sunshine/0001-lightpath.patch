+        g_variant_builder_init(&monitors, G_VARIANT_TYPE("a(ssa{sv})"));
+        g_variant_builder_add(&monitors, "(ss@a{sv})", connector.c_str(), mode.id.c_str(), g_variant_new_array(G_VARIANT_TYPE("{sv}"), nullptr, 0));
