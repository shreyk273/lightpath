diff --git a/src/platform/linux/muttergrab.cpp b/src/platform/linux/muttergrab.cpp
new file mode 100644
index 0000000..5c57f15
--- /dev/null
+++ b/src/platform/linux/muttergrab.cpp
@@ -0,0 +1,928 @@
+/**
+ * @file src/platform/linux/muttergrab.cpp
+ * @brief GNOME (Mutter) virtual display capture.
+ *
+ * For every stream this backend asks Mutter for a virtual monitor whose single mode is exactly
+ * the resolution and refresh rate the Moonlight client requested, makes it the only active
+ * display while the stream runs and captures it through PipeWire (DMA-BUF, zero-copy into the
+ * encoder). The client therefore receives pixels that were rendered for its own screen: no
+ * scaling on the host, no scaling on the client, no letterboxing, and frames paced by a
+ * compositor clock that runs at the client's refresh rate.
+ *
+ * Mutter's private ScreenCast/DisplayConfig D-Bus APIs are used directly, so no portal dialog,
+ * restore token or permission store juggling is involved. Everything is tied to a private D-Bus
+ * connection: if Sunshine exits or crashes the virtual monitor disappears and Mutter restores the
+ * user's saved physical monitor layout on its own.
+ */
+// standard includes
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdlib>
+#include <mutex>
+#include <optional>
+#include <stop_token>
+#include <string>
+#include <thread>
+#include <vector>
+
+// local includes
+#include "pipewire.cpp"
+
+using namespace std::literals;
+
+namespace mutter {
+  namespace {
+    constexpr const char *SCREENCAST_BUS = "org.gnome.Mutter.ScreenCast";
+    constexpr const char *SCREENCAST_PATH = "/org/gnome/Mutter/ScreenCast";
+    constexpr const char *SCREENCAST_IFACE = "org.gnome.Mutter.ScreenCast";
+    constexpr const char *SESSION_IFACE = "org.gnome.Mutter.ScreenCast.Session";
+    constexpr const char *STREAM_IFACE = "org.gnome.Mutter.ScreenCast.Stream";
+    constexpr const char *DISPLAY_CONFIG_BUS = "org.gnome.Mutter.DisplayConfig";
+    constexpr const char *DISPLAY_CONFIG_PATH = "/org/gnome/Mutter/DisplayConfig";
+    constexpr const char *DISPLAY_CONFIG_IFACE = "org.gnome.Mutter.DisplayConfig";
+    constexpr const char *SESSION_MANAGER_BUS = "org.gnome.SessionManager";
+    constexpr const char *SESSION_MANAGER_PATH = "/org/gnome/SessionManager";
+    constexpr const char *SESSION_MANAGER_IFACE = "org.gnome.SessionManager";
+
+    constexpr uint32_t CURSOR_MODE_EMBEDDED = 1;  ///< Cursor drawn into the frames.
+    constexpr uint32_t APPLY_TEMPORARY = 1;  ///< ApplyMonitorsConfig method: do not touch monitors.xml.
+    constexpr uint32_t INHIBIT_SUSPEND = 4;  ///< org.gnome.SessionManager inhibit flag.
+    constexpr uint32_t INHIBIT_IDLE = 8;  ///< org.gnome.SessionManager inhibit flag.
+    constexpr int DBUS_TIMEOUT_MS = 5000;
+    constexpr uint32_t MIN_API_VERSION = 4;  ///< RecordVirtual "modes" property.
+    constexpr auto STREAM_ADDED_TIMEOUT = 5s;
+    constexpr auto LAYOUT_SETTLE_TIMEOUT = 3s;
+    constexpr auto LINGER = 5s;  ///< Keep the virtual monitor across quick capture re-inits.
+    constexpr auto BLANK_DELAY = 1500ms;  ///< Let the stream start before power-cycling outputs.
+
+    /**
+     * @brief Read an environment variable as a double.
+     *
+     * @param name Variable name.
+     * @return Parsed value, or empty when unset/invalid.
+     */
+    std::optional<double> env_double(const char *name) {
+      const char *value = std::getenv(name);
+      if (!value || !*value) {
+        return std::nullopt;
+      }
+      char *end = nullptr;
+      const double parsed = std::strtod(value, &end);
+      if (end == value || !std::isfinite(parsed)) {
+        return std::nullopt;
+      }
+      return parsed;
+    }
+
+    /**
+     * @brief Read an environment variable as a boolean flag.
+     *
+     * @param name Variable name.
+     * @return True for 1/true/yes/on.
+     */
+    bool env_flag(const char *name) {
+      const char *value = std::getenv(name);
+      if (!value) {
+        return false;
+      }
+      const std::string_view v {value};
+      return v == "1" || v == "true" || v == "yes" || v == "on";
+    }
+  }  // namespace
+
+  /**
+   * @brief A single monitor mode as reported by DisplayConfig.GetCurrentState.
+   */
+  struct mode_info_t {
+    std::string id;  ///< Mode id used by ApplyMonitorsConfig.
+    int width = 0;  ///< Width in pixels.
+    int height = 0;  ///< Height in pixels.
+    double refresh = 0;  ///< Refresh rate in Hz.
+    double preferred_scale = 1;  ///< Mutter's own scale heuristic for this mode.
+    std::vector<double> supported_scales;  ///< Scales Mutter accepts for this mode.
+    bool is_current = false;  ///< Whether the mode is active.
+  };
+
+  /**
+   * @brief A physical or virtual monitor as reported by DisplayConfig.GetCurrentState.
+   */
+  struct monitor_info_t {
+    std::string connector;  ///< Connector name, e.g. "HDMI-1" or "Meta-0".
+    std::string vendor;  ///< Vendor string ("MetaVendor" for virtual monitors).
+    std::vector<mode_info_t> modes;  ///< Available modes.
+  };
+
+  /**
+   * @brief Snapshot of Mutter's monitor configuration.
+   */
+  struct display_state_t {
+    uint32_t serial = 0;  ///< Configuration serial required by ApplyMonitorsConfig.
+    std::vector<monitor_info_t> monitors;  ///< All connected monitors.
+    std::vector<std::string> active_connectors;  ///< Connectors that are part of a logical monitor.
+    std::string primary_connector;  ///< First connector of the primary logical monitor.
+
+    /**
+     * @brief Find a monitor by connector.
+     *
+     * @param connector Connector name.
+     * @return Monitor or nullptr.
+     */
+    const monitor_info_t *find(std::string_view connector) const {
+      for (const auto &monitor : monitors) {
+        if (monitor.connector == connector) {
+          return &monitor;
+        }
+      }
+      return nullptr;
+    }
+  };
+
+  /**
+   * @brief Owned GDBusConnection with RAII close semantics.
+   */
+  class connection_t {
+  public:
+    connection_t() = default;
+    connection_t(const connection_t &) = delete;
+    connection_t &operator=(const connection_t &) = delete;
+
+    ~connection_t() {
+      if (conn) {
+        g_dbus_connection_close_sync(conn, nullptr, nullptr);
+        g_object_unref(conn);
+      }
+    }
+
+    /**
+     * @brief Open a private session bus connection.
+     *
+     * A private connection makes Mutter clean up the virtual monitor as soon as it is closed, no
+     * matter how Sunshine goes away.
+     *
+     * @return True on success.
+     */
+    bool open() {
+      g_autoptr(GError) err = nullptr;
+      g_autofree gchar *address = g_dbus_address_get_for_bus_sync(G_BUS_TYPE_SESSION, nullptr, &err);
+      if (!address) {
+        BOOST_LOG(error) << "[muttergrab] No session bus: "sv << (err ? err->message : "unknown");
+        return false;
+      }
+      conn = g_dbus_connection_new_for_address_sync(
+        address,
+        GDBusConnectionFlags(G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION),
+        nullptr,
+        nullptr,
+        &err
+      );
+      if (!conn) {
+        BOOST_LOG(error) << "[muttergrab] Could not connect to session bus: "sv << err->message;
+        return false;
+      }
+      g_dbus_connection_set_exit_on_close(conn, FALSE);
+      return true;
+    }
+
+    /**
+     * @brief Synchronous D-Bus method call.
+     *
+     * @param bus Destination bus name.
+     * @param path Object path.
+     * @param iface Interface.
+     * @param method Method name.
+     * @param params Parameters (floating references are consumed), may be null.
+     * @param reply_type Expected reply type, may be null.
+     * @return Reply, or nullptr on error (logged).
+     */
+    GVariant *call(const char *bus, const char *path, const char *iface, const char *method, GVariant *params, const GVariantType *reply_type) const {
+      g_autoptr(GError) err = nullptr;
+      GVariant *reply = g_dbus_connection_call_sync(conn, bus, path, iface, method, params, reply_type, G_DBUS_CALL_FLAGS_NONE, DBUS_TIMEOUT_MS, nullptr, &err);
+      if (!reply) {
+        BOOST_LOG(warning) << "[muttergrab] "sv << iface << '.' << method << " failed: "sv << (err ? err->message : "unknown");
+      }
+      return reply;
+    }
+
+    GDBusConnection *conn = nullptr;  ///< Underlying connection.
+  };
+
+  /**
+   * @brief Query Mutter's current monitor configuration.
+   *
+   * @param conn D-Bus connection.
+   * @return Parsed state, or empty on error.
+   */
+  std::optional<display_state_t> get_display_state(const connection_t &conn) {
+    g_autoptr(GVariant) reply = conn.call(DISPLAY_CONFIG_BUS, DISPLAY_CONFIG_PATH, DISPLAY_CONFIG_IFACE, "GetCurrentState", nullptr, G_VARIANT_TYPE("(ua((ssss)a(siiddada{sv})a{sv})a(iiduba(ssss)a{sv})a{sv})"));
+    if (!reply) {
+      return std::nullopt;
+    }
+
+    display_state_t state;
+    g_variant_get_child(reply, 0, "u", &state.serial);
+
+    g_autoptr(GVariant) monitors = g_variant_get_child_value(reply, 1);
+    for (gsize i = 0; i < g_variant_n_children(monitors); ++i) {
+      g_autoptr(GVariant) monitor = g_variant_get_child_value(monitors, i);
+      monitor_info_t info;
+      const gchar *connector = nullptr;
+      const gchar *vendor = nullptr;
+      g_autoptr(GVariant) spec = g_variant_get_child_value(monitor, 0);
+      g_variant_get(spec, "(&s&s&s&s)", &connector, &vendor, nullptr, nullptr);
+      info.connector = connector;
+      info.vendor = vendor;
+
+      g_autoptr(GVariant) modes = g_variant_get_child_value(monitor, 1);
+      for (gsize m = 0; m < g_variant_n_children(modes); ++m) {
+        g_autoptr(GVariant) mode = g_variant_get_child_value(modes, m);
+        mode_info_t mi;
+        const gchar *id = nullptr;
+        g_autoptr(GVariant) scales = nullptr;
+        g_autoptr(GVariant) props = nullptr;
+        g_variant_get(mode, "(&siidd@ad@a{sv})", &id, &mi.width, &mi.height, &mi.refresh, &mi.preferred_scale, &scales, &props);
+        mi.id = id;
+        gsize n_scales = 0;
+        const auto *scale_values = static_cast<const double *>(g_variant_get_fixed_array(scales, &n_scales, sizeof(double)));
+        mi.supported_scales.assign(scale_values, scale_values + n_scales);
+        gboolean is_current = FALSE;
+        if (g_variant_lookup(props, "is-current", "b", &is_current)) {
+          mi.is_current = is_current;
+        }
+        info.modes.emplace_back(std::move(mi));
+      }
+      state.monitors.emplace_back(std::move(info));
+    }
+
+    g_autoptr(GVariant) logical = g_variant_get_child_value(reply, 2);
+    for (gsize i = 0; i < g_variant_n_children(logical); ++i) {
+      g_autoptr(GVariant) lm = g_variant_get_child_value(logical, i);
+      gboolean primary = FALSE;
+      g_variant_get_child(lm, 4, "b", &primary);
+      g_autoptr(GVariant) lm_monitors = g_variant_get_child_value(lm, 5);
+      for (gsize m = 0; m < g_variant_n_children(lm_monitors); ++m) {
+        g_autoptr(GVariant) spec = g_variant_get_child_value(lm_monitors, m);
+        const gchar *connector = nullptr;
+        g_variant_get(spec, "(&s&s&s&s)", &connector, nullptr, nullptr, nullptr);
+        state.active_connectors.emplace_back(connector);
+        if (primary && state.primary_connector.empty()) {
+          state.primary_connector = connector;
+        }
+      }
+    }
+
+    return state;
+  }
+
+  /**
+   * @brief Requested virtual monitor mode.
+   */
+  struct mode_request_t {
+    int width;  ///< Width in pixels.
+    int height;  ///< Height in pixels.
+    double refresh;  ///< Refresh rate in Hz.
+
+    /**
+     * @brief Compare two mode requests.
+     *
+     * @param other Other request.
+     * @return True when equal.
+     */
+    bool operator==(const mode_request_t &other) const {
+      return width == other.width && height == other.height && std::abs(refresh - other.refresh) < 0.01;
+    }
+  };
+
+  /**
+   * @brief A Mutter screencast session producing one PipeWire node.
+   *
+   * Either a virtual monitor (stream mode) or a recording of an existing monitor (encoder probe
+   * mode, which must not disturb the user's screens).
+   */
+  class screencast_session_t {
+  public:
+    screencast_session_t() = default;
+    screencast_session_t(const screencast_session_t &) = delete;
+    screencast_session_t &operator=(const screencast_session_t &) = delete;
+
+    ~screencast_session_t() {
+      if (!session_path.empty() && conn.conn && !g_dbus_connection_is_closed(conn.conn)) {
+        g_autoptr(GVariant) r = conn.call(SCREENCAST_BUS, session_path.c_str(), SESSION_IFACE, "Stop", nullptr, nullptr);
+      }
+      if (inhibit_cookie && conn.conn && !g_dbus_connection_is_closed(conn.conn)) {
+        g_autoptr(GVariant) r = conn.call(SESSION_MANAGER_BUS, SESSION_MANAGER_PATH, SESSION_MANAGER_IFACE, "Uninhibit", g_variant_new("(u)", inhibit_cookie), nullptr);
+      }
+      if (!connector.empty()) {
+        BOOST_LOG(info) << "[muttergrab] Virtual display "sv << connector << " removed; Mutter restores the saved monitor layout"sv;
+      }
+    }
+
+    /**
+     * @brief Create a virtual monitor with exactly one mode and start streaming it.
+     *
+     * @param mode Requested mode.
+     * @return True on success.
+     */
+    bool start_virtual(const mode_request_t &mode) {
+      if (!open_session()) {
+        return false;
+      }
+      const auto before = get_display_state(conn);
+      if (!before) {
+        return false;
+      }
+
+      GVariantBuilder mode_builder;
+      g_variant_builder_init(&mode_builder, G_VARIANT_TYPE("a{sv}"));
+      g_variant_builder_add(&mode_builder, "{sv}", "size", g_variant_new("(uu)", static_cast<uint32_t>(mode.width), static_cast<uint32_t>(mode.height)));
+      g_variant_builder_add(&mode_builder, "{sv}", "refresh-rate", g_variant_new_double(mode.refresh));
+      g_variant_builder_add(&mode_builder, "{sv}", "is-preferred", g_variant_new_boolean(TRUE));
+      GVariantBuilder modes_builder;
+      g_variant_builder_init(&modes_builder, G_VARIANT_TYPE("aa{sv}"));
+      g_variant_builder_add_value(&modes_builder, g_variant_builder_end(&mode_builder));
+
+      GVariantBuilder props;
+      g_variant_builder_init(&props, G_VARIANT_TYPE("a{sv}"));
+      g_variant_builder_add(&props, "{sv}", "cursor-mode", g_variant_new_uint32(CURSOR_MODE_EMBEDDED));
+      g_variant_builder_add(&props, "{sv}", "is-platform", g_variant_new_boolean(TRUE));
