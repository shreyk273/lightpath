+          g_variant_new("(uu@a(iiduba(ssa{sv}))@a{sv})", state->serial, APPLY_TEMPORARY, g_variant_builder_end(&logical), g_variant_new_array(G_VARIANT_TYPE("{sv}"), nullptr, 0)),
+          nullptr,
+          G_DBUS_CALL_FLAGS_NONE,
+          DBUS_TIMEOUT_MS,
+          nullptr,
+          &err
+        );
