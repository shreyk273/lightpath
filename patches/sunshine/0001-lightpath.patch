diff --git a/tests/unit/test_mac_keymap.cpp b/tests/unit/test_mac_keymap.cpp
new file mode 100644
index 0000000..680ef29
--- /dev/null
+++ b/tests/unit/test_mac_keymap.cpp
@@ -0,0 +1,679 @@
+/**
+ * @file tests/unit/test_mac_keymap.cpp
+ * @brief Tests for the macOS shortcut translator in src/mac_keymap.h.
+ *
+ * The translator is pure, so these tests feed client key sequences and check the exact host key
+ * stream: which shortcuts come out, that host modifiers are pressed before stale ones are
+ * released (no lone Alt taps that toggle menu bars), and, with a randomized stress test, that no
+ * host key is ever left pressed or released twice whatever order the client keys arrive in.
+ */
+#ifdef LIGHTPATH_STANDALONE_TEST
+  #include <gtest/gtest.h>
+#else
+  #include "../tests_common.h"
+#endif
+
+// standard includes
+#include <functional>
+#include <map>
+#include <random>
+#include <set>
+
+// local includes
+#include "src/mac_keymap.h"
+
+using namespace mac_keymap;
+
+namespace {
+  constexpr std::uint16_t KEY_A = 0x41;
+  constexpr std::uint16_t KEY_B = 0x42;
+  constexpr std::uint16_t KEY_C = 0x43;
+  constexpr std::uint16_t KEY_V = 0x56;
+  constexpr std::uint16_t KEY_Z = 0x5A;
+
+  host_event_t down(std::uint16_t code) {
+    return {code, false};
+  }
+
+  host_event_t up(std::uint16_t code) {
+    return {code, true};
+  }
+
+  /**
+   * @brief Drive a translator like Sunshine does and keep the full host stream.
+   */
+  struct harness_t {
+    translator_t t;
+    events_t host;
+    bool shift = false;
+
+    bool press(std::uint16_t code) {
+      return t.key(code, false, shift, host);
+    }
+
+    bool release(std::uint16_t code) {
+      return t.key(code, true, shift, host);
+    }
+
+    events_t take() {
+      events_t out;
+      out.swap(host);
+      return out;
+    }
+  };
+}  // namespace
+
+TEST(MacKeymapTest, CmdLettersBecomeCtrlShortcuts) {
+  harness_t h;
+  EXPECT_TRUE(h.press(vk::LWIN));
+  EXPECT_TRUE(h.press(KEY_C));
+  EXPECT_TRUE(h.release(KEY_C));
+  EXPECT_TRUE(h.press(KEY_V));
+  EXPECT_TRUE(h.release(KEY_V));
+  EXPECT_TRUE(h.release(vk::LWIN));
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), down(KEY_C), up(KEY_C), down(KEY_V), up(KEY_V), up(vk::RCONTROL)}));
+}
+
+TEST(MacKeymapTest, PlainTypingPassesThroughUntouched) {
+  harness_t h;
+  EXPECT_FALSE(h.press(KEY_A));
+  EXPECT_FALSE(h.release(KEY_A));
+  EXPECT_FALSE(h.press(vk::LEFT));
+  EXPECT_FALSE(h.release(vk::LEFT));
+  EXPECT_TRUE(h.take().empty());
+}
+
+TEST(MacKeymapTest, CmdShiftZKeepsShift) {
+  harness_t h;
+  h.shift = true;  // Shift itself travels the normal path
+  h.press(vk::LWIN);
+  h.press(KEY_Z);
+  h.release(KEY_Z);
+  h.release(vk::LWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), down(KEY_Z), up(KEY_Z), up(vk::RCONTROL)}));
+}
+
+TEST(MacKeymapTest, CmdTabHoldsAltUntilCmdIsReleased) {
+  harness_t h;
+  h.press(vk::LWIN);
+  h.press(vk::TAB);
+  h.release(vk::TAB);
+  h.press(vk::TAB);
+  h.release(vk::TAB);
+  h.release(vk::LWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), down(vk::LMENU), up(vk::RCONTROL), down(vk::TAB), up(vk::TAB), down(vk::TAB), up(vk::TAB), up(vk::LMENU)}));
+}
+
+TEST(MacKeymapTest, CmdBacktickCyclesWindowsOfTheApp) {
+  harness_t h;
+  h.press(vk::LWIN);
+  h.press(vk::OEM_3);
+  h.release(vk::OEM_3);
+  h.release(vk::LWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), down(vk::LMENU), up(vk::RCONTROL), down(vk::OEM_3), up(vk::OEM_3), up(vk::LMENU)}));
+}
+
+TEST(MacKeymapTest, OptionArrowsMoveByWordWithoutALoneAltTap) {
+  harness_t h;
+  h.press(vk::LMENU);
+  h.press(vk::LEFT);
+  h.release(vk::LEFT);
+  h.press(vk::RIGHT);
+  h.release(vk::RIGHT);
+  h.release(vk::LMENU);
+  // Ctrl goes down while Alt is still held, so Firefox & co. never see Alt pressed and released alone.
+  EXPECT_EQ(h.take(), (events_t {down(vk::LMENU), down(vk::RCONTROL), up(vk::LMENU), down(vk::LEFT), up(vk::LEFT), down(vk::RIGHT), up(vk::RIGHT), up(vk::RCONTROL)}));
+}
+
+TEST(MacKeymapTest, OptionBackspaceAndDeleteWorkOnWords) {
+  harness_t h;
+  h.press(vk::RMENU);
+  h.press(vk::BACK);
+  h.release(vk::BACK);
+  h.press(vk::DEL);
+  h.release(vk::DEL);
+  h.release(vk::RMENU);
+  EXPECT_EQ(h.take(), (events_t {down(vk::LMENU), down(vk::RCONTROL), up(vk::LMENU), down(vk::BACK), up(vk::BACK), down(vk::DEL), up(vk::DEL), up(vk::RCONTROL)}));
+}
+
+TEST(MacKeymapTest, OptionIsAltImmediatelyForGames) {
+  harness_t h;
+  h.press(vk::LMENU);
+  EXPECT_EQ(h.take(), (events_t {down(vk::LMENU)}));
+  h.press(KEY_B);
+  h.release(KEY_B);
+  h.release(vk::LMENU);
+  EXPECT_EQ(h.take(), (events_t {down(KEY_B), up(KEY_B), up(vk::LMENU)}));
+}
+
+TEST(MacKeymapTest, OptionAfterWordJumpReturnsToAlt) {
+  harness_t h;
+  h.press(vk::LMENU);
+  h.press(vk::LEFT);
+  h.release(vk::LEFT);
+  h.take();
+  h.press(KEY_B);
+  h.release(KEY_B);
+  h.release(vk::LMENU);
+  EXPECT_EQ(h.take(), (events_t {down(vk::LMENU), up(vk::RCONTROL), down(KEY_B), up(KEY_B), up(vk::LMENU)}));
+}
+
+TEST(MacKeymapTest, CmdArrowsJumpToLineAndDocumentEdges) {
+  harness_t h;
+  h.shift = true;
+  h.press(vk::LWIN);
+  h.press(vk::LEFT);
+  h.release(vk::LEFT);
+  h.press(vk::RIGHT);
+  h.release(vk::RIGHT);
+  h.press(vk::UP);
+  h.release(vk::UP);
+  h.press(vk::DOWN);
+  h.release(vk::DOWN);
+  h.release(vk::LWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), up(vk::RCONTROL), down(vk::HOME), up(vk::HOME), down(vk::END), up(vk::END), down(vk::RCONTROL), down(vk::HOME), up(vk::HOME), down(vk::END), up(vk::END), up(vk::RCONTROL)}));
+}
+
+TEST(MacKeymapTest, CmdBackspaceDeletesToLineStart) {
+  harness_t h;
+  h.press(vk::LWIN);
+  h.press(vk::BACK);
+  h.release(vk::BACK);
+  h.release(vk::LWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), up(vk::RCONTROL), down(vk::LSHIFT), down(vk::HOME), up(vk::HOME), up(vk::LSHIFT), down(vk::BACK), up(vk::BACK)}));
+
+  h.shift = true;  // already held by the user: no extra Shift
+  h.press(vk::LWIN);
+  h.press(vk::BACK);
+  h.release(vk::BACK);
+  h.release(vk::LWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), up(vk::RCONTROL), down(vk::HOME), up(vk::HOME), down(vk::BACK), up(vk::BACK)}));
+}
+
+TEST(MacKeymapTest, CmdSpaceOpensSearch) {
+  harness_t h;
+  h.press(vk::LWIN);
+  h.press(vk::SPACE);
+  h.release(vk::SPACE);
+  h.release(vk::LWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), up(vk::RCONTROL), down(vk::LWIN), up(vk::LWIN)}));
+}
+
+TEST(MacKeymapTest, CmdTappedAloneIsSuper) {
+  harness_t h;
+  h.press(vk::LWIN);
+  h.release(vk::LWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), up(vk::RCONTROL), down(vk::LWIN), up(vk::LWIN)}));
+  h.press(vk::RWIN);  // the right Cmd key too
+  h.release(vk::RWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), up(vk::RCONTROL), down(vk::LWIN), up(vk::LWIN)}));
+}
+
+TEST(MacKeymapTest, CmdUsedForAnythingElseIsNotSuper) {
+  const std::vector<std::function<void(harness_t &)>> uses {
+    [](harness_t &h) { h.press(KEY_C); h.release(KEY_C); },
+    [](harness_t &h) { h.press(vk::LSHIFT); },
+    [](harness_t &h) { h.press(vk::LMENU); h.release(vk::LMENU); },
+    [](harness_t &h) { h.press(vk::RWIN); h.release(vk::RWIN); },
+    [](harness_t &h) { h.t.pointer_button(h.host); },
+    [](harness_t &h) { h.t.pointer_used(); },
+  };
+  for (std::size_t i = 0; i < uses.size(); ++i) {
+    harness_t h;
+    h.press(vk::LWIN);
+    uses[i](h);
+    h.release(vk::LWIN);
+    for (const auto &e : h.take()) {
+      EXPECT_NE(e.vk, vk::LWIN) << "use #" << i << " still produced Super";
+    }
+  }
+}
+
+TEST(MacKeymapTest, CmdPressedWhileAKeyIsHeldIsNotSuper) {
+  harness_t h;
+  h.press(vk::LMENU);
+  h.press(vk::LEFT);  // held as Ctrl+Left
+  h.release(vk::LMENU);
+  h.press(vk::LWIN);
+  h.release(vk::LWIN);
+  for (const auto &e : h.take()) {
+    EXPECT_NE(e.vk, vk::LWIN);
+  }
+}
+
+TEST(MacKeymapTest, ControlCmdKeyIsSuperKey) {
+  harness_t h;
+  h.press(vk::LCONTROL);
+  h.press(vk::LWIN);
+  h.press(vk::LEFT);  // Super+Left tiles, not Home
+  h.release(vk::LEFT);
+  h.release(vk::LWIN);
+  h.release(vk::LCONTROL);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), down(vk::LWIN), up(vk::RCONTROL), down(vk::LEFT), up(vk::LEFT), down(vk::RCONTROL), up(vk::LWIN), up(vk::RCONTROL)}));
+}
+
+TEST(MacKeymapTest, CmdBeforeControlAlsoGivesSuper) {
+  harness_t h;
+  h.press(vk::LWIN);
+  h.press(vk::RCONTROL);
+  h.press(KEY_A);
+  h.release(KEY_A);
+  h.release(vk::RCONTROL);
+  h.release(vk::LWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), down(vk::LWIN), up(vk::RCONTROL), down(KEY_A), up(KEY_A), down(vk::RCONTROL), up(vk::LWIN), up(vk::RCONTROL)}));
+}
+
+TEST(MacKeymapTest, ControlAloneIsCtrlForTerminals) {
+  harness_t h;
+  h.t.set_terminal(true);
+  h.press(vk::LCONTROL);
+  EXPECT_FALSE(h.press(KEY_C));  // typed as is while the host holds Ctrl: interrupt
+  EXPECT_FALSE(h.release(KEY_C));
+  h.release(vk::LCONTROL);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), up(vk::RCONTROL)}));
+}
+
+TEST(MacKeymapTest, CmdCopyPasteInATerminalUsesCtrlShift) {
+  harness_t h;
+  h.t.set_terminal(true);
+  h.press(vk::LWIN);
+  h.press(KEY_C);
+  h.release(KEY_C);
+  h.press(KEY_V);
+  h.release(KEY_V);
+  h.release(vk::LWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), down(vk::RSHIFT), down(KEY_C), up(KEY_C), up(vk::RSHIFT), down(vk::RSHIFT), down(KEY_V), up(KEY_V), up(vk::RSHIFT), up(vk::RCONTROL)}));
+}
+
+TEST(MacKeymapTest, CmdShiftLetterInATerminalAddsNoSecondShift) {
+  harness_t h;
+  h.t.set_terminal(true);
+  h.shift = true;
+  h.press(vk::LWIN);
+  h.press(vk::KEY_T);
+  h.release(vk::KEY_T);
+  h.release(vk::LWIN);
+  EXPECT_EQ(h.take(), (events_t {down(vk::RCONTROL), down(vk::KEY_T), up(vk::KEY_T), up(vk::RCONTROL)}));
+}
+
+TEST(MacKeymapTest, TerminalLineAndWordDeletion) {
+  harness_t h;
+  h.t.set_terminal(true);
+  h.press(vk::LWIN);
+  h.press(vk::BACK);
+  h.release(vk::BACK);
+  h.release(vk::LWIN);
