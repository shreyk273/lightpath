+     * address and keep using the tunnel even when it is on the same LAN. Advertising the LAN
+     * address lets it switch to the direct path whenever that is reachable.
+     *
+     * @param local Local endpoint address of the request.
+     * @return Address to advertise.
+     */
+    boost::asio::ip::address advertised_local_address(const boost::asio::ip::address &local) {
+      if (is_overlay_address(local)) {
+        if (auto lan = default_route_v4()) {
+          return *lan;
+        }
+      }
+      return local;
+    }
+  }  // namespace
