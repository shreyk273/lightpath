diff --git a/cmake/compile_definitions/linux.cmake b/cmake/compile_definitions/linux.cmake
index b47c48a..894acfb 100644
--- a/cmake/compile_definitions/linux.cmake
+++ b/cmake/compile_definitions/linux.cmake
@@ -262,7 +262,7 @@ if(GIO_FOUND)
 endif()
 
 # Pipewire
-if(${SUNSHINE_ENABLE_KWIN} OR ${SUNSHINE_ENABLE_PORTAL})
+if(${SUNSHINE_ENABLE_KWIN} OR ${SUNSHINE_ENABLE_PORTAL} OR ${SUNSHINE_ENABLE_MUTTER})
     pkg_check_modules(PIPEWIRE libpipewire-0.3 REQUIRED)
 else()
     set(PIPEWIRE_FOUND OFF)
@@ -283,6 +283,15 @@ if(PIPEWIRE_FOUND AND GIO_FOUND AND ${SUNSHINE_ENABLE_PORTAL})
             "${CMAKE_SOURCE_DIR}/src/platform/linux/portalgrab.cpp")
 endif()
 
+# GNOME Mutter virtual display (Mutter's ScreenCast D-Bus API, bypasses portal)
+set(MUTTER_FOUND OFF)
+if(PIPEWIRE_FOUND AND GIO_FOUND AND WAYLAND_FOUND AND ${SUNSHINE_ENABLE_MUTTER})
+    set(MUTTER_FOUND ON)
+    add_compile_definitions(SUNSHINE_BUILD_MUTTER)
+    list(APPEND PLATFORM_TARGET_FILES
+            "${CMAKE_SOURCE_DIR}/src/platform/linux/muttergrab.cpp")
+endif()
+
 # KWin ScreenCast (direct Wayland protocol, bypasses portal)
 set(KWIN_FOUND OFF)
 if(PIPEWIRE_FOUND AND WAYLAND_FOUND AND ${SUNSHINE_ENABLE_KWIN})
