+     *
+     * @return Address, or empty when there is no usable default route.
+     */
+    std::optional<boost::asio::ip::address> default_route_v4() {
+      boost::asio::io_context io;
+      boost::system::error_code ec;
+      boost::asio::ip::udp::socket socket(io);
+      socket.open(boost::asio::ip::udp::v4(), ec);
+      if (!ec) {
+        socket.connect({boost::asio::ip::make_address_v4("1.1.1.1"), 53}, ec);
+      }
+      if (ec) {
+        return std::nullopt;
+      }
+      const auto address = socket.local_endpoint(ec).address();
+      if (ec || address.is_unspecified() || is_overlay_address(address)) {
+        return std::nullopt;
+      }
+      return address;
+    }
