+   * @return Display backend, or nullptr when initialization fails.
+   */
+  std::shared_ptr<display_t> mutter_display(mem_type_e hwdevice_type, const std::string &display_name, const video::config_t &config) {
+    if (!pipewire::pipewire_display_t::init_pipewire_and_check_hwdevice_type(hwdevice_type)) {
+      BOOST_LOG(error) << "[muttergrab] Could not initialize pipewire-based display with the given hw device type."sv;
+      return nullptr;
+    }
+
+    auto display = std::make_shared<mutter::mutter_t>(config);
+    if (display->init(hwdevice_type, display_name, config)) {
+      return nullptr;
+    }
+    return display;
+  }
+
+  /**
+   * @brief Enumerate Mutter virtual display names.
+   *
+   * @return A single name: the virtual display is created per stream to match the client.
+   */
+  std::vector<std::string> mutter_display_names() {
+    if (!mutter::available()) {
+      return {};
+    }
+    // The "Meta-" prefix tells the PipeWire layer that frame timestamps come from a virtual
+    // monitor's own clock and are reliable for pacing.
+    return {"Meta-virtual"};
+  }
