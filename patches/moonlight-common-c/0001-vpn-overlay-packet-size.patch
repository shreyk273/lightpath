From ea8cadf8151121d4fc00bb6fa0ea4c7509551402 Mon Sep 17 00:00:00 2001
From: Shreyansh Kaushik <smkaushi@ucsc.edu>
Date: Tue, 17 Nov 2026 00:27:23 -0800
Subject: [PATCH] Size video packets for VPN overlays (Tailscale) to one
 1280-byte MTU

---
 src/Connection.c      | 13 ++++++++++++-
 src/PlatformSockets.c | 17 +++++++++++++++++
 src/PlatformSockets.h |  1 +
 3 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/src/Connection.c b/src/Connection.c
index c07b7b0..ea13219 100644
--- a/src/Connection.c
+++ b/src/Connection.c
@@ -407,7 +407,18 @@ int LiStartConnection(PSERVER_INFORMATION serverInfo, PSTREAM_CONFIGURATION stre
 
         // It's possible to have a NAT64 prefix on a ULA or other private range,
         // so we must exclude NAT64 addresses from our local address checks.
-        if (!isNat64 && isPrivateNetworkAddress(&RemoteAddr)) {
+        if (isTunnelOverlayAddress(&RemoteAddr)) {
+            // VPN overlay (Tailscale/WireGuard): treat as remote, but size video packets to fill
+            // exactly one 1280 byte tunnel MTU: IPv6 (40) + UDP (8) + RTP (16) = 64 bytes of headers.
+            // The generic remote caps (1024 for IPv4) would waste ~17% of packets, and the ULA
+            // IPv6 range would otherwise be treated as LAN with packets that get fragmented.
+            StreamConfig.streamingRemotely = STREAM_CFG_REMOTE;
+            if (StreamConfig.packetSize > 1216) {
+                Limelog("Packet size capped at 1216 bytes for VPN overlay streaming\n");
+                StreamConfig.packetSize = 1216;
+            }
+        }
+        else if (!isNat64 && isPrivateNetworkAddress(&RemoteAddr)) {
             StreamConfig.streamingRemotely = STREAM_CFG_LOCAL;
         }
         else {
diff --git a/src/PlatformSockets.c b/src/PlatformSockets.c
index 25236a1..6cf1f87 100644
--- a/src/PlatformSockets.c
+++ b/src/PlatformSockets.c
@@ -796,6 +796,23 @@ bool isPrivateNetworkAddress(struct sockaddr_storage* address) {
     return false;
 }
 
+// Tailscale assigns 100.64.0.0/10 (shared with carrier-grade NAT) and fd7a:115c:a1e0::/48.
+// Both are reached through a WireGuard tunnel with a 1280 byte MTU.
+bool isTunnelOverlayAddress(struct sockaddr_storage* address) {
+    if (address->ss_family == AF_INET) {
+        unsigned int addr;
+        memcpy(&addr, &((struct sockaddr_in*)address)->sin_addr, sizeof(addr));
+        return (htonl(addr) & 0xFFC00000) == 0x64400000;
+    }
+#ifdef AF_INET6
+    else if (address->ss_family == AF_INET6) {
+        static unsigned char tailscalePrefix[] = {0xfd, 0x7a, 0x11, 0x5c, 0xa1, 0xe0};
+        return isInSubnetV6((struct sockaddr_in6*)address, tailscalePrefix, 48);
+    }
+#endif
+    return false;
+}
+
 bool isNat64SynthesizedAddress(struct sockaddr_storage* address) {
 #ifdef AF_INET6
     if (address->ss_family == AF_INET6) {
diff --git a/src/PlatformSockets.h b/src/PlatformSockets.h
index 38e2061..20d18e4 100644
--- a/src/PlatformSockets.h
+++ b/src/PlatformSockets.h
@@ -134,6 +134,7 @@ void shutdownTcpSocket(SOCKET s);
 int setNonFatalRecvTimeoutMs(SOCKET s, int timeoutMs);
 void closeSocket(SOCKET s);
 bool isPrivateNetworkAddress(struct sockaddr_storage* address);
+bool isTunnelOverlayAddress(struct sockaddr_storage* address);
 bool isNat64SynthesizedAddress(struct sockaddr_storage* address);
 int pollSockets(struct pollfd* pollFds, int pollFdsCount, int timeoutMs);
 bool isSocketReadable(SOCKET s);
