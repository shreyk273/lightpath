+}
+
+bool SdlInputHandler::handleMagnify(float magnification, bool gestureEnded)
+{
+    if (gestureEnded) {
+        m_Pinch.reset();
+        return true;
+    }
+
+    if (!isTrackpadTargetingStream()) {
+        return false;
+    }
+
+    // Pinch becomes Ctrl+wheel, which zooms in browsers, viewers and editors on the host
+    for (int steps = m_Pinch.add(magnification); steps != 0; steps += (steps > 0) ? -1 : 1) {
