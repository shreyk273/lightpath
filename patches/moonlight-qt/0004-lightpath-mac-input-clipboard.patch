+
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+static int s_Failures = 0;
+
+#define CHECK(cond) \
+    do { \
+        if (!(cond)) { \
+            std::printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); \
+            s_Failures++; \
+        } \
+    } while (0)
+
+static std::vector<short> chunksOf(int64_t amount)
+{
+    std::vector<short> chunks;
+    Trackpad::sendScrollInChunks(amount, [&chunks](short chunk) { chunks.push_back(chunk); });
+    return chunks;
+}
+
+static int64_t sumOf(const std::vector<short>& chunks)
+{
+    int64_t sum = 0;
+    for (short chunk : chunks) {
+        sum += chunk;
+    }
+    return sum;
+}
+
+static void testScrollUnits()
+{
+    // 10 points = one notch
+    Trackpad::ScrollAccumulator acc;
+    CHECK(acc.add(10.0f) == 120);
+    CHECK(acc.add(-10.0f) == -120);
+
+    // Tiny deltas add up instead of being rounded away: 100 x 0.05 pt = 5 pt = 60 units
+    Trackpad::ScrollAccumulator slow;
+    int64_t total = 0;
+    for (int i = 0; i < 100; i++) {
+        total += slow.add(0.05f);
+    }
+    CHECK(total >= 59 && total <= 60);
+    CHECK(slow.add(0.0f) == 0);
+
+    // A single sub-unit delta sends nothing yet, the next one carries it over
+    Trackpad::ScrollAccumulator carry;
+    CHECK(carry.add(0.05f) == 0); // 0.6 units
+    CHECK(carry.add(0.05f) == 1); // 1.2 units -> 1, 0.2 left
+    carry.reset();
+    CHECK(carry.add(0.05f) == 0);
+
+    // No clamping: a fast momentum flick of 400 points goes through in full
+    Trackpad::ScrollAccumulator fast;
+    CHECK(fast.add(400.0f) == 4800);
+}
+
+static void testScrollSigns()
+{
+    // Natural scrolling: fingers moving down => scrollingDeltaY > 0 => scroll up (positive)
+    Trackpad::PreciseScroll scroll;
+    Trackpad::ScrollAmounts a = scroll.add(0.0f, 10.0f, false);
+    CHECK(a.vertical == 120 && a.horizontal == 0);
+
+    // scrollingDeltaX > 0 means scroll left (negative horizontal), as in SDL (x = -deltaX)
+    a = scroll.add(10.0f, 0.0f, false);
+    CHECK(a.vertical == 0 && a.horizontal == -120);
+
+    // The reverse-scroll preference flips both axes
+    Trackpad::PreciseScroll reversed;
+    a = reversed.add(10.0f, 10.0f, true);
+    CHECK(a.vertical == -120 && a.horizontal == 120);
+}
+
+static void testWheelNotches()
+{
+    // One mouse wheel notch = 60 points = 720 units, sign kept, accelerated notches unclamped
+    Trackpad::ScrollAmounts a = Trackpad::wheelNotchAmounts(0.0f, 1.0f, false);
+    CHECK(a.vertical == 720 && a.horizontal == 0);
+    a = Trackpad::wheelNotchAmounts(0.0f, -3.0f, false);
+    CHECK(a.vertical == -2160);
+    a = Trackpad::wheelNotchAmounts(1.0f, 0.0f, false);
+    CHECK(a.vertical == 0 && a.horizontal == 720);
+    a = Trackpad::wheelNotchAmounts(1.0f, 1.0f, true);
+    CHECK(a.vertical == -720 && a.horizontal == -720);
+
+    // 50 accelerated notches overflow int16 and are split
+    a = Trackpad::wheelNotchAmounts(0.0f, 50.0f, false);
+    CHECK(a.vertical == 36000);
+    CHECK(chunksOf(a.vertical) == std::vector<short>({32767, 3233}));
+}
+
+static void testChunking()
+{
+    CHECK(chunksOf(0).empty());
+    CHECK(chunksOf(1) == std::vector<short>({1}));
+    CHECK(chunksOf(32767) == std::vector<short>({32767}));
+    CHECK(chunksOf(32768) == std::vector<short>({32767, 1}));
+    CHECK(chunksOf(-32768) == std::vector<short>({-32767, -1}));
+
+    std::vector<short> big = chunksOf(100000);
+    CHECK(big.size() == 4);
+    CHECK(sumOf(big) == 100000);
+
+    std::vector<short> bigNegative = chunksOf(-100000);
+    CHECK(sumOf(bigNegative) == -100000);
+    for (short chunk : bigNegative) {
+        CHECK(chunk < 0 && chunk != -32768);
+    }
+
+    std::vector<short> huge = chunksOf(5000000000LL);
+    CHECK(sumOf(huge) == 5000000000LL);
+}
+
+static void testPinch()
+{
+    Trackpad::PinchAccumulator pinch;
+    CHECK(pinch.add(0.05f) == 0);
+    CHECK(pinch.add(0.05f) == 1);   // 0.10 -> one step, 0.02 left
+    CHECK(pinch.add(-0.2f) == -2);  // -0.18 -> two steps out, -0.02 left
+    pinch.reset();
+    CHECK(pinch.add(0.07f) == 0);
+    pinch.reset();
+    CHECK(pinch.add(0.5f) == 6);    // 0.48 used, 0.02 left
+    CHECK(pinch.add(0.06f) == 1);
+    CHECK(pinch.add(0.0f) == 0);
+}
+
+static void testSwipe()
+{
+    CHECK(Trackpad::swipeActionForDeltaX(1.0f) == Trackpad::SwipeAction::Back);
+    CHECK(Trackpad::swipeActionForDeltaX(-1.0f) == Trackpad::SwipeAction::Forward);
+    CHECK(Trackpad::swipeActionForDeltaX(0.0f) == Trackpad::SwipeAction::None);
+    CHECK(Trackpad::swipeActionForDeltaX(0.2f) == Trackpad::SwipeAction::None);
+
+    // Back = Cmd+[, Forward = Cmd+]
+    CHECK(Trackpad::swipeShortcutKey(Trackpad::SwipeAction::Back) == 0xDB);
+    CHECK(Trackpad::swipeShortcutKey(Trackpad::SwipeAction::Forward) == 0xDD);
+    CHECK(Trackpad::swipeShortcutKey(Trackpad::SwipeAction::None) == 0);
+
+    struct Key { short vk; bool down; bool meta; bool extended; };
+    auto record = [](short vk, bool cmdHeld) {
+        std::vector<Key> keys;
+        Trackpad::sendCmdShortcut(vk, cmdHeld, [&keys](short key, bool down, bool meta, bool extended) {
+            keys.push_back({key, down, meta, extended});
+        });
+        return keys;
+    };
+
+    // Cmd not held: Cmd down, key down/up with Meta, Cmd up
+    std::vector<Key> keys = record(0xDB, false);
+    CHECK(keys.size() == 4);
+    if (keys.size() == 4) {
+        CHECK(keys[0].vk == 0x5B && keys[0].down && keys[0].meta && keys[0].extended);
+        CHECK(keys[1].vk == 0xDB && keys[1].down && keys[1].meta && !keys[1].extended);
+        CHECK(keys[2].vk == 0xDB && !keys[2].down && keys[2].meta);
+        CHECK(keys[3].vk == 0x5B && !keys[3].down && !keys[3].meta && keys[3].extended);
+    }
+
+    // Cmd already held by the user: only the key, so their Cmd stays down
+    keys = record(0xDD, true);
+    CHECK(keys.size() == 2);
+    if (keys.size() == 2) {
+        CHECK(keys[0].vk == 0xDD && keys[0].down && keys[0].meta);
+        CHECK(keys[1].vk == 0xDD && !keys[1].down && keys[1].meta);
+    }
+}
+
+static uint64_t hashText(const char* text)
+{
+    return ClipboardSyncState::contentHash("text/plain;charset=utf-8", text, std::strlen(text));
+}
+
+static void testClipboardState()
+{
+    CHECK(hashText("a") == hashText("a"));
+    CHECK(hashText("a") != hashText("b"));
+    CHECK(ClipboardSyncState::contentHash("text/plain;charset=utf-8", "a", 1) !=
+          ClipboardSyncState::contentHash("image/png", "a", 1));
+    CHECK(hashText("") != 0);
+
+    ClipboardSyncState state;
+
+    // Nothing synced yet: whatever is on the Mac gets sent
+    CHECK(state.shouldPush(5));
+    state.markPushStarted(5);
+    CHECK(!state.shouldPush(5));
+    CHECK(state.shouldPush(6));
+
+    // Our own push coming back from the host is not written to the Mac again
+    state.markPushSucceeded(hashText("mac copy"));
+    CHECK(!state.acceptHostContent(state.nextPullTicket(), 10, hashText("mac copy"), 5, 5));
+
+    // Same host sequence number: nothing new on the PC
+    CHECK(!state.acceptHostContent(state.nextPullTicket(), 10, hashText("other"), 5, 5));
+
+    // A new PC copy is applied, and the resulting pasteboard change isn't pushed back
+    CHECK(state.acceptHostContent(state.nextPullTicket(), 11, hashText("pc copy"), 5, 5));
+    state.markApplied(7, hashText("pc copy"));
+    CHECK(!state.shouldPush(7));
+
+    // An older pull finishing after a newer one is ignored
+    uint64_t older = state.nextPullTicket();
+    uint64_t newer = state.nextPullTicket();
+    CHECK(state.acceptHostContent(newer, 12, hashText("newest"), 7, 7));
+    CHECK(!state.acceptHostContent(older, 13, hashText("stale"), 7, 7));
+
+    // The Mac copied something while the pull was in flight: the Mac copy wins, and the
+    // host content is still considered on a later pull
+    CHECK(!state.acceptHostContent(state.nextPullTicket(), 14, hashText("pc later"), 7, 8));
+    CHECK(state.acceptHostContent(state.nextPullTicket(), 14, hashText("pc later"), 8, 8));
+
+    // A failed push is retried on the next focus change, unless the Mac copied again
+    state.markPushStarted(9);
+    state.markPushFailed(9);
+    CHECK(state.shouldPush(9));
+    state.markPushStarted(10);
+    state.markPushFailed(9);
+    CHECK(!state.shouldPush(10));
+}
+
+int main()
+{
+    testScrollUnits();
+    testScrollSigns();
+    testChunking();
+    testWheelNotches();
+    testPinch();
+    testSwipe();
+    testClipboardState();
+
+    if (s_Failures == 0) {
+        std::printf("lightpath input tests: all passed\n");
+        return 0;
+    }
+    std::printf("lightpath input tests: %d failure(s)\n", s_Failures);
+    return 1;
+}
