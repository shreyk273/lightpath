+        LiSendScrollEvent(steps > 0 ? 1 : -1);
+        LiSendKeyboardEvent2((short)(0x8000 | 0xA2), KEY_ACTION_UP, 0, 0);
+    }
+
+    return true;
+}
+
+bool SdlInputHandler::handleSmartMagnify()
+{
+    if (!isTrackpadTargetingStream()) {
+        return false;
+    }
+
+    // Two-finger double tap: reset the zoom (Ctrl+0)
+    sendModifiedKeyTap(0xA2, MODIFIER_CTRL, 0x30, false);
+    return true;
+}
+
+bool SdlInputHandler::handleSwipe(float deltaX)
