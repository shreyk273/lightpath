+bool
+NvHTTP::getLightpathClipboard(QByteArray& data, QString& contentType, quint64& seq, int timeoutMs)
+{
+    QNetworkReply* reply = openConnection(m_BaseUrlHttps,
+                                          "lightpath/clipboard",
+                                          nullptr,
+                                          timeoutMs,
+                                          NvLogLevel::NVLL_ERROR);
+    bool hasData = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt() == 200;
