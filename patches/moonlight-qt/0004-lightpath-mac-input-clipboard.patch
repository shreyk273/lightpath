diff --git a/app/streaming/input/trackpad.h b/app/streaming/input/trackpad.h
new file mode 100644
index 0000000..46918c1
--- /dev/null
+++ b/app/streaming/input/trackpad.h
@@ -0,0 +1,178 @@
+#pragma once
+
+// Lightpath: pure helpers that turn macOS trackpad input into Moonlight input events.
+// Kept free of SDL/AppKit so they can be tested on their own (see tests/lightpath).
+
+#include <climits>
+#include <cmath>
+#include <cstdint>
+
+namespace Trackpad {
+
+// High-res wheel units per point of finger travel: 10 points = 120 = one wheel notch.
+constexpr float kScrollUnitsPerPoint = 12.0f;
+
+// Pinch magnification per discrete zoom step (Ctrl + one wheel notch on the host).
+constexpr float kPinchStep = 0.08f;
+
+// Converts precise scroll deltas (points, any size, including macOS momentum) into whole
+// high-res wheel units. The fractional remainder carries over, so slow scrolls add up
+// exactly and nothing is lost to rounding.
+class ScrollAccumulator
+{
+public:
+    int64_t add(float points)
+    {
+        m_Remainder += (double)points * kScrollUnitsPerPoint;
+        int64_t whole = (int64_t)m_Remainder; // toward zero
+        m_Remainder -= (double)whole;
+        return whole;
+    }
+
+    void reset()
+    {
+        m_Remainder = 0;
+    }
+
+private:
+    double m_Remainder = 0;
+};
+
+struct ScrollAmounts
+{
+    int64_t vertical;   // positive = scroll up (wheel away from the user)
+    int64_t horizontal; // positive = scroll right
+};
+
+// AppKit precise deltas -> wheel amounts. scrollingDeltaY > 0 already means "scroll up" in
+// the user's chosen direction (natural scrolling included); scrollingDeltaX > 0 means
+// "scroll left", hence the flip, matching SDL's convention for the same events.
+class PreciseScroll
+{
+public:
+    ScrollAmounts add(float scrollingDeltaX, float scrollingDeltaY, bool reverse)
+    {
+        if (reverse) {
+            scrollingDeltaX = -scrollingDeltaX;
+            scrollingDeltaY = -scrollingDeltaY;
+        }
+        return { m_Y.add(scrollingDeltaY), m_X.add(-scrollingDeltaX) };
+    }
+
+private:
+    ScrollAccumulator m_X;
+    ScrollAccumulator m_Y;
+};
+
+// A Lightpath host treats a Mac's scroll amounts as points (see kScrollUnitsPerPoint), so a
+// mouse wheel notch is sent as 60 points, about what one notch scrolls in a native Mac app.
+constexpr float kPointsPerWheelNotch = 60.0f;
+
+// SDL wheel values (notches; preciseY > 0 = up, preciseX > 0 = right) -> wheel amounts.
+// No clamping: macOS wheel acceleration is kept, like in native apps.
+inline ScrollAmounts wheelNotchAmounts(float preciseX, float preciseY, bool reverse)
+{
+    double scale = (double)kPointsPerWheelNotch * kScrollUnitsPerPoint * (reverse ? -1 : 1);
+    return { std::llround(preciseY * scale), std::llround(preciseX * scale) };
+}
+
+// The wire format carries a signed 16-bit amount per event; larger amounts are split.
+// SHRT_MIN is avoided so every chunk can be negated safely on the host.
+template <typename SendFn>
+void sendScrollInChunks(int64_t amount, SendFn send)
+{
+    while (amount != 0) {
+        int64_t chunk = amount;
+        if (chunk > SHRT_MAX) {
+            chunk = SHRT_MAX;
+        }
+        else if (chunk < -SHRT_MAX) {
+            chunk = -SHRT_MAX;
+        }
+        send((short)chunk);
+        amount -= chunk;
+    }
+}
+
+// Turns macOS magnification deltas into discrete zoom steps: positive = zoom in.
+class PinchAccumulator
+{
+public:
+    int add(float magnification)
+    {
+        m_Accumulated += magnification;
+        int steps = 0;
+        while (m_Accumulated >= kPinchStep) {
+            m_Accumulated -= kPinchStep;
+            steps++;
+        }
+        while (m_Accumulated <= -kPinchStep) {
+            m_Accumulated += kPinchStep;
+            steps--;
+        }
+        return steps;
+    }
+
+    void reset()
+    {
+        m_Accumulated = 0;
+    }
+
+private:
+    float m_Accumulated = 0;
+};
+
+// NSEventTypeSwipe (three-finger "swipe between pages"): deltaX > 0 is a left-to-right
+// swipe, which is Back in Safari and Chrome; deltaX < 0 is Forward.
+enum class SwipeAction
+{
+    None,
+    Back,
+    Forward,
+};
+
+inline SwipeAction swipeActionForDeltaX(float deltaX)
+{
+    if (deltaX > 0.5f) {
+        return SwipeAction::Back;
+    }
+    else if (deltaX < -0.5f) {
+        return SwipeAction::Forward;
+    }
+    return SwipeAction::None;
+}
+
+constexpr short kVkLeftWin = 0x5B;
+constexpr short kVkOpenBracket = 0xDB;
+constexpr short kVkCloseBracket = 0xDD;
+
+// Page swipes are sent as the Mac's own Back/Forward shortcuts, Cmd+[ and Cmd+], which a
+// Lightpath host turns into Alt+Left/Alt+Right. Returns 0 for no action.
+inline short swipeShortcutKey(SwipeAction action)
+{
+    switch (action) {
+    case SwipeAction::Back:
+        return kVkOpenBracket;
+    case SwipeAction::Forward:
+        return kVkCloseBracket;
+    default:
+        return 0;
+    }
+}
+
+// Sends Cmd+vk as key events: send(vk, down, meta, extended). If the user is already
+// holding Cmd, only the key itself is pressed so their Cmd isn't released under them.
+template <typename SendKeyFn>
+void sendCmdShortcut(short vk, bool cmdHeld, SendKeyFn send)
+{
+    if (!cmdHeld) {
+        send(kVkLeftWin, true, true, true);
+    }
+    send(vk, true, true, false);
+    send(vk, false, true, false);
+    if (!cmdHeld) {
+        send(kVkLeftWin, false, false, true);
+    }
+}
+
+}
