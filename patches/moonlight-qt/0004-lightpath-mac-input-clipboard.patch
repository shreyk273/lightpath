diff --git a/app/streaming/clipboardsync.h b/app/streaming/clipboardsync.h
new file mode 100644
index 0000000..2ee2195
--- /dev/null
+++ b/app/streaming/clipboardsync.h
@@ -0,0 +1,134 @@
+#pragma once
+
+// Lightpath: shared clipboard between the Mac and a Lightpath host, synced at the moments
+// the user moves between them (no polling):
+//  - the stream window gains focus (and once at stream start): a new Mac copy is sent to the PC
+//  - the stream window loses focus, and when the stream ends: a new PC copy is brought to the Mac
+// Transfers use the paired HTTPS channel (GET/POST /lightpath/clipboard). Hosts without the
+// endpoint (404) simply turn the feature off for the stream.
+
+#include <cstddef>
+#include <cstdint>
+
+class NvComputer;
+
+#ifdef __APPLE__
+void ClipboardSync_Begin(NvComputer* computer);
+void ClipboardSync_FocusChanged(bool focused);
+void ClipboardSync_End();
+#else
+static inline void ClipboardSync_Begin(NvComputer*) {}
+static inline void ClipboardSync_FocusChanged(bool) {}
+static inline void ClipboardSync_End() {}
+#endif
+
+// Pure bookkeeping (main thread only) that keeps both sides from echoing each other's
+// copies back and stops stale or reordered transfers from overwriting newer ones.
+class ClipboardSyncState
+{
+public:
+    static constexpr size_t kMaxBytes = 16 * 1024 * 1024;
+
+    // FNV-1a over the content type and bytes
+    static uint64_t contentHash(const char* type, const void* data, size_t length)
+    {
+        uint64_t hash = 0xcbf29ce484222325ULL;
+        auto mix = [&hash](const unsigned char* p, size_t n) {
+            for (size_t i = 0; i < n; i++) {
+                hash ^= p[i];
+                hash *= 0x100000001b3ULL;
+            }
+        };
+        for (const char* c = type; c != nullptr && *c != 0; c++) {
+            mix((const unsigned char*)c, 1);
+        }
+        mix((const unsigned char*)"\0", 1);
+        mix((const unsigned char*)data, length);
+        return hash;
+    }
+
+    // Mac -> PC: does the pasteboard hold something the PC hasn't seen yet?
+    bool shouldPush(long changeCount) const
+    {
+        return !m_HaveChangeCount || changeCount != m_SyncedChangeCount;
+    }
+
+    // Records that this pasteboard state is being handled (sent, or skipped as empty/too big),
+    // so it isn't sent again on the next focus change.
+    void markPushStarted(long changeCount)
+    {
+        m_HaveChangeCount = true;
+        m_SyncedChangeCount = changeCount;
+    }
+
+    // The host now holds this content (transfers complete in order).
+    void markPushSucceeded(uint64_t hash)
+    {
+        m_HaveHash = true;
+        m_SyncedHash = hash;
+    }
+
+    // The transfer failed: try again on the next focus change unless the Mac copied again.
+    void markPushFailed(long changeCount)
+    {
+        if (m_HaveChangeCount && m_SyncedChangeCount == changeCount) {
+            m_HaveChangeCount = false;
+        }
+    }
+
+    // PC -> Mac: each pull gets an increasing ticket; only the newest result may be applied.
+    uint64_t nextPullTicket()
+    {
+        return ++m_LastPullTicket;
+    }
+
+    // Decides whether host content fetched with `ticket` should be written to the Mac.
+    // `changeCountAtPull` is the pasteboard change count when the pull was requested.
+    bool acceptHostContent(uint64_t ticket, uint64_t seq, uint64_t hash,
+                           long changeCountAtPull, long currentChangeCount)
+    {
+        if (ticket <= m_LastAppliedTicket) {
+            // An older pull finishing after a newer one
+            return false;
+        }
+        m_LastAppliedTicket = ticket;
+
+        if (currentChangeCount != changeCountAtPull) {
+            // The user copied something on the Mac meanwhile; that copy wins
+            return false;
+        }
+
+        if (m_HaveSeq && seq == m_LastSeq) {
+            // The host clipboard hasn't changed since we last looked
+            return false;
+        }
+        m_HaveSeq = true;
+        m_LastSeq = seq;
+
+        if (m_HaveHash && hash == m_SyncedHash) {
+            // Our own push coming back, or identical content
+            return false;
+        }
+
+        return true;
+    }
+
+    // Records that host content was written to the pasteboard (now at `newChangeCount`).
+    void markApplied(long newChangeCount, uint64_t hash)
+    {
+        m_HaveChangeCount = true;
+        m_SyncedChangeCount = newChangeCount;
+        m_HaveHash = true;
+        m_SyncedHash = hash;
+    }
+
+private:
+    bool m_HaveChangeCount = false;
+    long m_SyncedChangeCount = 0;
+    bool m_HaveHash = false;
+    uint64_t m_SyncedHash = 0;
+    bool m_HaveSeq = false;
+    uint64_t m_LastSeq = 0;
+    uint64_t m_LastPullTicket = 0;
+    uint64_t m_LastAppliedTicket = 0;
+};
diff --git a/app/streaming/clipboardsync_mac.mm b/app/streaming/clipboardsync_mac.mm
new file mode 100644
index 0000000..d2d84f0
--- /dev/null
+++ b/app/streaming/clipboardsync_mac.mm
@@ -0,0 +1,360 @@
+#import <AppKit/AppKit.h>
+
+#include "clipboardsync.h"
+#include "backend/nvcomputer.h"
+#include "backend/nvhttp.h"
+
+#include "SDL_compat.h"
+
+#include <QMutex>
+#include <QReadLocker>
+#include <QSemaphore>
+#include <QThreadPool>
+
+#include <functional>
+#include <memory>
+
+namespace {
+
+const char* const kTextType = "text/plain;charset=utf-8";
+const char* const kPngType = "image/png";
+
+const int kPushTimeoutMs = 30000;
+const int kPullTimeoutMs = 10000;
+const int kFinalPullWaitMs = 500;
+
+// TIFF screenshots shrink a lot as PNG, so allow more before converting
+const qsizetype kMaxTiffBytes = 4 * (qsizetype)ClipboardSyncState::kMaxBytes;
+
+struct HostTarget
+{
+    NvAddress address;
+    uint16_t httpsPort = 0;
+    QSslCertificate serverCert;
+    bool useTrueUid = true;
+};
+
+struct PullResult
+{
+    bool hasData = false;
+    bool unsupported = false;
+    quint64 seq = 0;
+    QByteArray data;
+    QString type;
+};
+
+// Main thread state
+bool s_Active = false;
+bool s_HostSupported = false;
+HostTarget s_Host;
+ClipboardSyncState s_State;
+
+// One worker, so transfers run in order and a pull never overtakes a push
+QThreadPool* transferPool()
+{
+    static QThreadPool* pool = [] {
+        QThreadPool* p = new QThreadPool();
+        p->setMaxThreadCount(1);
+        return p;
+    }();
+    return pool;
+}
+
+void runOnMainThread(std::function<void()> fn)
+{
+    dispatch_async_f(dispatch_get_main_queue(), new std::function<void()>(std::move(fn)), [](void* context) {
+        auto fn = static_cast<std::function<void()>*>(context);
+        (*fn)();
+        delete fn;
+    });
+}
+
+uint64_t hashOf(const QByteArray& data, const QString& type)
+{
+    QByteArray typeUtf8 = type.toUtf8();
+    return ClipboardSyncState::contentHash(typeUtf8.constData(), data.constData(), (size_t)data.size());
+}
+
+bool isNotFound(const QtNetworkReplyException& e)
+{
+    return e.getError() == QNetworkReply::ContentNotFoundError;
+}
+
+void handleUnsupportedHost()
+{
+    if (s_HostSupported) {
+        SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
+                    "Lightpath clipboard: host doesn't support clipboard sync");
+        s_HostSupported = false;
+    }
+}
+
+void applyHostClipboard(uint64_t ticket, long changeCountAtPull, const PullResult& result)
+{
+    if (result.unsupported) {
+        handleUnsupportedHost();
+        return;
+    }
+    if (!result.hasData || result.data.isEmpty() || (size_t)result.data.size() > ClipboardSyncState::kMaxBytes) {
+        return;
+    }
+
+    bool isText = result.type.startsWith("text/plain", Qt::CaseInsensitive);
+    bool isPng = result.type.startsWith(kPngType, Qt::CaseInsensitive);
+    if (!isText && !isPng) {
+        return;
+    }
+
+    @autoreleasepool {
+        NSPasteboard* pasteboard = [NSPasteboard generalPasteboard];
+        uint64_t hash = hashOf(result.data, isText ? kTextType : kPngType);
+        if (!s_State.acceptHostContent(ticket, result.seq, hash, changeCountAtPull, (long)pasteboard.changeCount)) {
+            return;
+        }
+
+        if (isText) {
+            NSString* text = [[[NSString alloc] initWithData:result.data.toNSData()
+                                                    encoding:NSUTF8StringEncoding] autorelease];
+            if (text == nil) {
+                return;
+            }
+            [pasteboard clearContents];
+            [pasteboard setString:text forType:NSPasteboardTypeString];
+        }
+        else {
+            NSData* png = result.data.toNSData();
+            NSBitmapImageRep* image = [NSBitmapImageRep imageRepWithData:png];
+            if (image == nil) {
+                return;
+            }
+            // PNG for modern apps, TIFF for the ones that only take the classic type
+            [pasteboard clearContents];
+            [pasteboard setData:png forType:NSPasteboardTypePNG];
+            NSData* tiff = [image TIFFRepresentation];
+            if (tiff != nil) {
+                [pasteboard setData:tiff forType:NSPasteboardTypeTIFF];
+            }
+        }
+
+        s_State.markApplied((long)pasteboard.changeCount, hash);
+    }
+
+    SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
+                "Lightpath clipboard: copied %s from the host (%lld bytes)",
+                isText ? "text" : "an image", (long long)result.data.size());
+}
+
+PullResult fetchHostClipboard(const HostTarget& host, int timeoutMs)
+{
+    PullResult result;
+    try {
+        NvHTTP http(host.address, host.httpsPort, host.serverCert, host.useTrueUid);
+        result.hasData = http.getLightpathClipboard(result.data, result.type, result.seq, timeoutMs);
+    } catch (const QtNetworkReplyException& e) {
+        result.unsupported = isNotFound(e);
+        if (!result.unsupported) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION,
+                        "Lightpath clipboard: fetching from the host failed: %s",
+                        e.what());
+        }
+    } catch (const GfeHttpResponseException& e) {
+        SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION,
+                    "Lightpath clipboard: fetching from the host failed: %s",
+                    e.what());
+    }
+    return result;
+}
+
+// Shared between the final pull and the main thread waiting (briefly) for it
+struct FinalPull
+{
+    QMutex lock;
+    QSemaphore done;
+    bool finished = false;
+    bool abandoned = false;
+    PullResult result;
+};
+
+void pullHostClipboard(std::shared_ptr<FinalPull> finalPull = nullptr)
+{
+    if (!s_HostSupported) {
+        return;
+    }
+
+    uint64_t ticket = s_State.nextPullTicket();
+    long changeCountAtPull = (long)[NSPasteboard generalPasteboard].changeCount;
+    HostTarget host = s_Host;
+
+    transferPool()->start([=]() {
+        PullResult result = fetchHostClipboard(host, finalPull ? kFinalPullWaitMs : kPullTimeoutMs);
+
+        if (finalPull) {
+            QMutexLocker locker(&finalPull->lock);
+            finalPull->result = result;
+            finalPull->finished = true;
+            if (finalPull->abandoned) {
+                // The main thread stopped waiting; apply whenever it's free again
+                runOnMainThread([=]() { applyHostClipboard(ticket, changeCountAtPull, result); });
+            }
+            finalPull->done.release();
+            return;
+        }
+
+        runOnMainThread([=]() { applyHostClipboard(ticket, changeCountAtPull, result); });
+    });
+
+    if (finalPull) {
+        if (!finalPull->done.tryAcquire(1, kFinalPullWaitMs)) {
+            QMutexLocker locker(&finalPull->lock);
+            if (!finalPull->finished) {
+                finalPull->abandoned = true;
+                return;
+            }
+        }
+        applyHostClipboard(ticket, changeCountAtPull, finalPull->result);
+    }
+}
+
+void pushMacClipboard()
+{
+    if (!s_HostSupported) {
+        return;
+    }
+
+    NSPasteboard* pasteboard = [NSPasteboard generalPasteboard];
+    long changeCount = (long)pasteboard.changeCount;
+    if (!s_State.shouldPush(changeCount)) {
+        return;
+    }
+    s_State.markPushStarted(changeCount);
+
+    QByteArray data;
+    QString type;
+    bool needsPngConversion = false;
+    @autoreleasepool {
+        NSString* text = [pasteboard stringForType:NSPasteboardTypeString];
+        NSData* image;
+        if (text != nil) {
+            data = QByteArray::fromNSData([text dataUsingEncoding:NSUTF8StringEncoding]);
+            type = kTextType;
+        }
+        else if ((image = [pasteboard dataForType:NSPasteboardTypePNG]) != nil) {
+            data = QByteArray::fromNSData(image);
+            type = kPngType;
+        }
+        else if ((image = [pasteboard dataForType:NSPasteboardTypeTIFF]) != nil && (qsizetype)image.length <= kMaxTiffBytes) {
+            data = QByteArray::fromNSData(image);
+            type = kPngType;
+            needsPngConversion = true;
+        }
+    }
+
+    if (data.isEmpty()) {
+        // Nothing we can share (files, other formats, or an empty pasteboard)
+        return;
+    }
+
+    HostTarget host = s_Host;
+    transferPool()->start([=]() mutable {
+        if (needsPngConversion) {
+            @autoreleasepool {
+                NSBitmapImageRep* image = [NSBitmapImageRep imageRepWithData:data.toRawNSData()];
+                NSData* png = [image representationUsingType:NSBitmapImageFileTypePNG properties:@{}];
+                data = png != nil ? QByteArray::fromNSData(png) : QByteArray();
+            }
+        }
+
+        if (data.isEmpty() || (size_t)data.size() > ClipboardSyncState::kMaxBytes) {
+            SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
+                        "Lightpath clipboard: not sending %lld bytes (limit %zu)",
+                        (long long)data.size(), ClipboardSyncState::kMaxBytes);
+            return;
+        }
+
+        uint64_t hash = hashOf(data, type);
+        bool sent = false;
+        bool unsupported = false;
+        try {
+            NvHTTP http(host.address, host.httpsPort, host.serverCert, host.useTrueUid);
+            http.setLightpathClipboard(data, type, kPushTimeoutMs);
+            sent = true;
+        } catch (const QtNetworkReplyException& e) {
+            unsupported = isNotFound(e);
+            if (!unsupported) {
+                SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION,
+                            "Lightpath clipboard: sending to the host failed: %s",
+                            e.what());
+            }
+        } catch (const GfeHttpResponseException& e) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION,
+                        "Lightpath clipboard: sending to the host failed: %s",
+                        e.what());
+        }
+
+        if (sent) {
+            SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
+                        "Lightpath clipboard: sent %s to the host (%lld bytes)",
+                        type == kTextType ? "text" : "an image", (long long)data.size());
+        }
+
+        runOnMainThread([=]() {
+            if (sent) {
+                s_State.markPushSucceeded(hash);
+            }
+            else {
+                s_State.markPushFailed(changeCount);
+                if (unsupported) {
+                    handleUnsupportedHost();
+                }
+            }
+        });
+    });
+}
+
+}
+
+void ClipboardSync_Begin(NvComputer* computer)
+{
+    if (computer == nullptr) {
+        return;
+    }
+
+    {
+        QReadLocker lock(&computer->lock);
+        s_Host.address = computer->activeAddress;
+        s_Host.httpsPort = computer->activeHttpsPort;
+        s_Host.serverCert = computer->serverCert;
+        s_Host.useTrueUid = !computer->isNvidiaServerSoftware;
+    }
+
+    // Needs the paired HTTPS channel
+    s_HostSupported = !s_Host.address.isNull() && s_Host.httpsPort != 0 && !s_Host.serverCert.isNull();
+    s_Active = true;
+
+    pushMacClipboard();
+}
+
+void ClipboardSync_FocusChanged(bool focused)
+{
+    if (!s_Active) {
+        return;
+    }
+
+    if (focused) {
+        pushMacClipboard();
+    }
+    else {
+        pullHostClipboard();
+    }
+}
+
+void ClipboardSync_End()
+{
+    if (!s_Active) {
+        return;
+    }
+    s_Active = false;
+
+    // Bring over anything copied on the PC before the stream goes away
+    pullHostClipboard(std::make_shared<FinalPull>());
+}
