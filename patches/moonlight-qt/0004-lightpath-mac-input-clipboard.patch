+    // Unlike the SDL wheel path, nothing is clamped: fast flicks and the momentum macOS
+    // adds after the fingers lift carry through 1:1, like scrolling in a native app.
+    Trackpad::ScrollAmounts amounts = m_PreciseScroll.add(scrollingDeltaX, scrollingDeltaY, m_ReverseScrollDirection);
+    Trackpad::sendScrollInChunks(amounts.vertical, [](short amount) {
+        LiSendHighResScrollEvent(amount);
+    });
+    Trackpad::sendScrollInChunks(amounts.horizontal, [](short amount) {
+        LiSendHighResHScrollEvent(amount);
