diff --git a/app/streaming/input/macinput.h b/app/streaming/input/macinput.h
new file mode 100644
index 0000000..a77b8a9
--- /dev/null
+++ b/app/streaming/input/macinput.h
@@ -0,0 +1,22 @@
+#pragma once
+
+// Lightpath: macOS-native trackpad input and Cmd shortcuts while streaming.
+//  - Precise scrolling (trackpad, Magic Mouse) goes 1:1 to the host, including momentum
+//  - Pinch zooms (Ctrl+wheel), a two-finger double tap resets zoom (Ctrl+0)
+//  - A three-finger page swipe goes Back/Forward (Alt+Left/Right)
+//  - While the keyboard is captured, Moonlight's menu stops claiming Cmd+Q/H/W/M... so those
+//    reach the host too. macOS Spaces/Mission Control gestures are left alone, so the user
+//    can always swipe out of the stream.
+
+struct SDL_Window;
+class SdlInputHandler;
+
+#ifdef __APPLE__
+void MacInput_Begin(SDL_Window* window, SdlInputHandler* inputHandler);
+void MacInput_End();
+void MacInput_SetMenuShortcutsSuppressed(bool suppressed);
+#else
+static inline void MacInput_Begin(SDL_Window*, SdlInputHandler*) {}
+static inline void MacInput_End() {}
+static inline void MacInput_SetMenuShortcutsSuppressed(bool) {}
+#endif
diff --git a/app/streaming/input/macinput_mac.mm b/app/streaming/input/macinput_mac.mm
new file mode 100644
index 0000000..554a263
--- /dev/null
+++ b/app/streaming/input/macinput_mac.mm
@@ -0,0 +1,135 @@
+#import <AppKit/AppKit.h>
+
+#include "macinput.h"
+#include "input.h"
+
+#include <SDL_syswm.h>
+
+// All state is touched on the main thread only (AppKit event monitors run there too).
+static id s_EventMonitor = nil;
+static NSWindow* s_StreamWindow = nil; // not retained, only compared against
+static SdlInputHandler* s_InputHandler = nullptr;
+static bool s_SuppressMenuShortcuts = false;
+static NSMenu* s_SavedMainMenu = nil;
+static NSMenu* s_EmptyMainMenu = nil;
+
+// AppKit gives the main menu the first look at every Cmd key, so Moonlight's menu would quit
+// (Cmd+Q) or hide (Cmd+H) instead of the PC getting the shortcut. SDL has already seen the
+// key by then, so an empty main menu is all it takes to pass it through.
+static void applyMenuSuppression()
+{
+    if (s_SuppressMenuShortcuts) {
+        if (s_EmptyMainMenu == nil) {
+            s_EmptyMainMenu = [[NSMenu alloc] initWithTitle:@""];
+        }
+
+        NSMenu* current = [NSApp mainMenu];
+        if (current != s_EmptyMainMenu) {
+            // Keep whatever menu is current; Qt may have installed a newer one meanwhile
+            [current retain];
+            [s_SavedMainMenu release];
+            s_SavedMainMenu = current;
+            [NSApp setMainMenu:s_EmptyMainMenu];
+        }
+    }
+    else if (s_EmptyMainMenu != nil) {
+        // Only undo our own swap
+        if ([NSApp mainMenu] == s_EmptyMainMenu) {
+            [NSApp setMainMenu:s_SavedMainMenu];
+        }
+
+        [s_SavedMainMenu release];
+        s_SavedMainMenu = nil;
+        [s_EmptyMainMenu release];
+        s_EmptyMainMenu = nil;
+    }
+}
+
+static void removeEventMonitor()
+{
+    if (s_EventMonitor != nil) {
+        [NSEvent removeMonitor:s_EventMonitor];
+        [s_EventMonitor release];
+        s_EventMonitor = nil;
+    }
+
+    s_StreamWindow = nil;
+    s_InputHandler = nullptr;
+}
+
+void MacInput_Begin(SDL_Window* window, SdlInputHandler* inputHandler)
+{
+    // Keyboard capture (and with it the menu suppression) may already be active
+    removeEventMonitor();
+
+    SDL_SysWMinfo info;
+    SDL_VERSION(&info.version);
+    if (window == nullptr || inputHandler == nullptr ||
+            !SDL_GetWindowWMInfo(window, &info) || info.subsystem != SDL_SYSWM_COCOA) {
+        SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION,
+                    "Lightpath input: no Cocoa window, trackpad gestures disabled");
+        return;
+    }
+
+    s_StreamWindow = info.info.cocoa.window;
+    s_InputHandler = inputHandler;
+
+    // SDL turns trackpad scrolling into clamped wheel notches and drops pinch and swipe
+    // gestures, so take these events straight from AppKit. Scroll events this handles are
+    // consumed (SDL only generates wheel events when the window dispatches them).
+    NSEventMask mask = NSEventMaskScrollWheel | NSEventMaskMagnify |
+                       NSEventMaskSmartMagnify | NSEventMaskSwipe | NSEventMaskKeyDown;
+    s_EventMonitor = [[NSEvent addLocalMonitorForEventsMatchingMask:mask
+                                                            handler:^NSEvent*(NSEvent* event) {
+        if (event.type == NSEventTypeKeyDown) {
+            // Qt can reinstall its menu (e.g. when the app is reactivated), so make sure
+            // it's still out of the way before AppKit matches this key against it
+            if (event.modifierFlags & NSEventModifierFlagCommand) {
+                applyMenuSuppression();
+            }
+            return event;
+        }
+
+        if (s_InputHandler == nullptr || event.window != s_StreamWindow) {
+            return event;
+        }
+
+        switch (event.type) {
+        case NSEventTypeScrollWheel:
+            // Trackpads and Magic Mice report precise deltas in points, including the
+            // momentum phase after the fingers lift. Mouse wheels keep SDL's path.
+            if (event.hasPreciseScrollingDeltas &&
+                    s_InputHandler->handlePreciseScroll(event.scrollingDeltaX, event.scrollingDeltaY)) {
+                return nil;
+            }
+            return event;
+
+        case NSEventTypeMagnify:
+            s_InputHandler->handleMagnify(event.magnification,
+                                          event.phase == NSEventPhaseEnded ||
+                                          event.phase == NSEventPhaseCancelled);
+            return event;
+
+        case NSEventTypeSmartMagnify:
+            return s_InputHandler->handleSmartMagnify() ? nil : event;
+
+        case NSEventTypeSwipe:
+            return s_InputHandler->handleSwipe(event.deltaX) ? nil : event;
+
+        default:
+            return event;
+        }
+    }] retain];
+}
+
+void MacInput_End()
+{
+    removeEventMonitor();
+    MacInput_SetMenuShortcutsSuppressed(false);
+}
+
+void MacInput_SetMenuShortcutsSuppressed(bool suppressed)
+{
+    s_SuppressMenuShortcuts = suppressed;
+    applyMenuSuppression();
+}
